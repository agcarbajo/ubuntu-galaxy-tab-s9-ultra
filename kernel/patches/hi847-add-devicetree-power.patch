diff --git a/drivers/media/i2c/hi847.c b/drivers/media/i2c/hi847.c
--- a/drivers/media/i2c/hi847.c
+++ b/drivers/media/i2c/hi847.c
@@ -4,10 +4,12 @@
 #include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
 #include <linux/unaligned.h>
 
 #include <media/v4l2-ctrls.h>
@@ -2171,6 +2173,9 @@ struct hi847 {
 	struct device *dev;
 	struct clk *clk;
+	struct regulator *vddio;
+	struct gpio_desc *enable_gpio;
+	struct gpio_desc *reset_gpio;
 
 	struct v4l2_subdev sd;
 	struct media_pad pad;
@@ -2764,7 +2769,58 @@ static const struct v4l2_subdev_internal_ops hi847_internal_ops = {
 	.open = hi847_open,
 };
 
+/* Samsung's module must remain powered between consecutive stream opens. */
+static int hi847_power_on(struct hi847 *hi847)
+{
+	int ret;
+
+	if (hi847->vddio) {
+		ret = regulator_enable(hi847->vddio);
+		if (ret)
+			return ret;
+	}
+
+	if (hi847->enable_gpio)
+		gpiod_set_value_cansleep(hi847->enable_gpio, 1);
+	usleep_range(1000, 1500);
+
+	ret = clk_prepare_enable(hi847->clk);
+	if (ret)
+		goto disable_enable;
+
+	usleep_range(1000, 1500);
+	if (hi847->reset_gpio)
+		gpiod_set_value_cansleep(hi847->reset_gpio, 0);
+	usleep_range(5000, 6000);
+
+	return 0;
+
+disable_enable:
+	if (hi847->enable_gpio)
+		gpiod_set_value_cansleep(hi847->enable_gpio, 0);
+	if (hi847->vddio)
+		regulator_disable(hi847->vddio);
+	return ret;
+}
+
+static void hi847_power_off(struct hi847 *hi847)
+{
+	if (hi847->reset_gpio)
+		gpiod_set_value_cansleep(hi847->reset_gpio, 1);
+	clk_disable_unprepare(hi847->clk);
+	if (hi847->enable_gpio)
+		gpiod_set_value_cansleep(hi847->enable_gpio, 0);
+	if (hi847->vddio)
+		regulator_disable(hi847->vddio);
+}
+
 static int hi847_identify_module(struct hi847 *hi847)
 {
 	int ret;
@@ -2850,6 +2905,7 @@ static void hi847_remove(struct i2c_client *client)
 	media_entity_cleanup(&sd->entity);
 	v4l2_ctrl_handler_free(sd->ctrl_handler);
 	pm_runtime_disable(hi847->dev);
+	hi847_power_off(hi847);
 	mutex_destroy(&hi847->mutex);
 }
 
@@ -2869,6 +2925,20 @@ static int hi847_probe(struct i2c_client *client)
 		return dev_err_probe(hi847->dev, PTR_ERR(hi847->clk),
 				     "failed to get clock\n");
 
+	hi847->vddio = devm_regulator_get_optional(hi847->dev, "vddio");
+	if (PTR_ERR(hi847->vddio) == -ENODEV)
+		hi847->vddio = NULL;
+	if (IS_ERR(hi847->vddio))
+		return dev_err_probe(hi847->dev, PTR_ERR(hi847->vddio),
+				     "failed to get vddio regulator\n");
+
+	hi847->enable_gpio = devm_gpiod_get_optional(hi847->dev, "enable",
+						       GPIOD_OUT_LOW);
+	if (IS_ERR(hi847->enable_gpio))
+		return dev_err_probe(hi847->dev, PTR_ERR(hi847->enable_gpio),
+				     "failed to get enable GPIO\n");
+	hi847->reset_gpio = devm_gpiod_get_optional(hi847->dev, "reset",
+						      GPIOD_OUT_HIGH);
+	if (IS_ERR(hi847->reset_gpio))
+		return dev_err_probe(hi847->dev, PTR_ERR(hi847->reset_gpio),
+				     "failed to get reset GPIO\n");
+
 	freq = clk_get_rate(hi847->clk);
 	if (freq != HI847_MCLK)
 		return dev_err_probe(hi847->dev, -EINVAL,
@@ -2884,11 +2954,20 @@ static int hi847_probe(struct i2c_client *client)
 	}
 
 	v4l2_i2c_subdev_init(&hi847->sd, client, &hi847_subdev_ops);
+
+	ret = hi847_power_on(hi847);
+	if (ret)
+		return dev_err_probe(hi847->dev, ret,
+				     "failed to power on sensor\n");
+
 	ret = hi847_identify_module(hi847);
 	if (ret) {
+		hi847_power_off(hi847);
 		dev_err(hi847->dev, "failed to find sensor: %d", ret);
 		return ret;
 	}
 
 	mutex_init(&hi847->mutex);
 	hi847->cur_mode = &supported_modes[0];
 	ret = hi847_init_controls(hi847);
@@ -2934,6 +3004,7 @@ probe_error_v4l2_ctrl_handler_free:
 	v4l2_ctrl_handler_free(hi847->sd.ctrl_handler);
 	mutex_destroy(&hi847->mutex);
+	hi847_power_off(hi847);
 
 	return ret;
 }
@@ -2941,10 +3019,18 @@ static const struct acpi_device_id hi847_acpi_ids[] = {
 };
 
 MODULE_DEVICE_TABLE(acpi, hi847_acpi_ids);
 #endif
 
+static const struct of_device_id hi847_of_match[] = {
+	{ .compatible = "hynix,hi847" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hi847_of_match);
+
 static struct i2c_driver hi847_i2c_driver = {
 	.driver = {
 		.name = "hi847",
 		.acpi_match_table = ACPI_PTR(hi847_acpi_ids),
+		.of_match_table = hi847_of_match,
 	},
 	.probe = hi847_probe,
 	.remove = hi847_remove,

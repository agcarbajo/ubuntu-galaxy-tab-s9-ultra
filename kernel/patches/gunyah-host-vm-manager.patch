index 0000000000000000000000000000000000000000..e643e33668b4e1c8ceab453d8824791d21508e23
--- /dev/null
+++ b/drivers/virt/gunyah/vm_mgr.c
@@ -0,0 +1,830 @@
+// SPDX-License-Identifier: GPL-2.0-only

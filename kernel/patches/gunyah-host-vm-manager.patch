+
+#ifndef _GH_VM_MGR_H
+#define _GH_VM_MGR_H
+
+#include <linux/gunyah_rsc_mgr.h>
+#include <linux/gunyah_vm_mgr.h>
+#include <linux/list.h>
+#include <linux/kref.h>
+#include <linux/miscdevice.h>

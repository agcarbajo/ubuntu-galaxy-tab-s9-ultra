 	return gh_rm_call(rm, GH_RM_RPC_VM_STOP, &req_payload, sizeof(req_payload), NULL, NULL);
 }
 
+int gh_rm_vm_authenticate(struct gh_rm *rm, u16 vmid, size_t n_entries,
+			  const struct gh_rm_vm_authenticate_param_entry *entries)
+{
+	struct gh_rm_vm_authenticate_req_header *header;
+	size_t request_size, response_size = 0;
+	void *request, *response = NULL;
+	int ret;
+
+	if (n_entries > U16_MAX)
+		return -EINVAL;
+	if (check_mul_overflow(n_entries, sizeof(*entries), &request_size) ||
+	    check_add_overflow(request_size, sizeof(*header), &request_size))
+		return -EOVERFLOW;
+
+	request = kzalloc(request_size, GFP_KERNEL);
+	if (!request)
+		return -ENOMEM;
+
+	header = request;
+	header->vmid = cpu_to_le16(vmid);
+	header->n_params = cpu_to_le16(n_entries);
+	memcpy(header + 1, entries, n_entries * sizeof(*entries));
+
+	ret = gh_rm_call(rm, GH_RM_RPC_VM_AUTH_IMAGE, request, request_size,
+			 &response, &response_size);
+	if (!ret && response_size)
+		ret = -EINVAL;
+
+	kfree(response);
+	kfree(request);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gh_rm_vm_authenticate);
+

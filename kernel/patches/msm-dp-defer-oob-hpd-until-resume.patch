+static void msm_dp_bridge_deferred_hpd_work(struct work_struct *work)
+{
+	struct msm_dp_bridge *msm_dp_bridge =
+		container_of(to_delayed_work(work), struct msm_dp_bridge,
+			     deferred_hpd_work);
+	struct device *dev = &msm_dp_bridge->msm_dp_display->pdev->dev;
+	enum drm_connector_status status;
+
+	if (!READ_ONCE(msm_dp_bridge->deferred_hpd_pending))
+		return;
+
+	status = READ_ONCE(msm_dp_bridge->deferred_hpd_status);
+	WRITE_ONCE(msm_dp_bridge->deferred_hpd_pending, false);
+
+	dev_info(dev,
+		 "replaying deferred Type-C DP HPD status=%d after first resume\n",
+		 status);
+	msm_dp_bridge_hpd_notify(&msm_dp_bridge->bridge, NULL, status);
+}
+
+static int msm_dp_bridge_pm_notifier(struct notifier_block *notifier,
+				     unsigned long action, void *unused)
+{
+	struct msm_dp_bridge *msm_dp_bridge =
+		container_of(notifier, struct msm_dp_bridge, pm_notifier);
+
+	if (action != PM_POST_SUSPEND ||
+	    !READ_ONCE(msm_dp_bridge->defer_hpd_until_resume))
+		return NOTIFY_DONE;
+
+	WRITE_ONCE(msm_dp_bridge->defer_hpd_until_resume, false);
+	if (READ_ONCE(msm_dp_bridge->deferred_hpd_pending))
+		schedule_delayed_work(&msm_dp_bridge->deferred_hpd_work,
+				      msecs_to_jiffies(3000));
+
+	return NOTIFY_OK;
+}
+
+static void msm_dp_bridge_unregister_pm_notifier(void *data)
+{
+	struct msm_dp_bridge *msm_dp_bridge = data;
+
+	unregister_pm_notifier(&msm_dp_bridge->pm_notifier);
+	cancel_delayed_work_sync(&msm_dp_bridge->deferred_hpd_work);
+}

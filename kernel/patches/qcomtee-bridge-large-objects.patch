 	phys_addr_t paddr;
 	void *vaddr;
 
 	if (size < QCOMTEE_TZMEM_OBJECT_MIN_SIZE)
 		return tee_dyn_shm_alloc_helper(shm, size, align,
 						qcomtee_shm_register);
 
 	size = PAGE_ALIGN(size);
+	/* A page-backed object is enough to be read, but the BAUTH application
+	 * registers its two buffers with QTEE itself, which needs one whole
+	 * contiguous bridge.  Objects in that size range get one of their own;
+	 * the signed TA image is far larger and stays on the TZMEM pool. */
+	if (size <= QCOMTEE_BRIDGED_SHM_MAX_SIZE &&
+	    !qcomtee_bridged_alloc(shm, size))
+		return 0;
+
 	vaddr = qcom_tzmem_alloc(qpool->tzmem, size,
 				  GFP_KERNEL | GFP_DMA32);
 	if (!vaddr)
 		return -ENOMEM;

+// Hexagon cannot combine reshape and FP16/FP32 conversion in one CPY.
+// Convert a contiguous source first, then preserve the original copy layout.
+static struct ggml_tensor * whisper_graph_copy(struct ggml_context * ctx,
+        struct ggml_tensor * src, struct ggml_tensor * dst) {
+    if (src->type != dst->type) {
+        if (!ggml_is_contiguous(src)) src = ggml_cont(ctx, src);
+        src = ggml_cast(ctx, src, dst->type);
+    }
+    return ggml_cpy(ctx, src, dst);
+}

[Unit]
Description=Experimental Galaxy Tab S9 Ultra HTP NPU session
After=local-fs.target
After=ubuntu-gts9u-adsp-boot.service ubuntu-gts9u-fingerprint-secure.service

[Service]
Type=notify
ExecStart=/opt/gts9u-npu-session/bin/run-npu-session.py
KillMode=mixed
TimeoutStartSec=120
TimeoutStopSec=45
RuntimeDirectory=gts9u-npu
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077

[Install]
WantedBy=multi-user.target

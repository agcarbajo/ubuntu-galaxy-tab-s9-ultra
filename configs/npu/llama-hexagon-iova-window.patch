+// The DSP's delayed mappings still occupy host IOVA space in mainline FastRPC.
+// Register only the current working set. Drain all queued work before evicting
+// a buffer, then release DSP references before unmapping it from FastRPC.
+void ggml_hexagon_session::prepare_iova_window() {
+    if (!opt_iova_window) return;
+    size_t mapped = 0, extra = 0, allocated = 0;
+    for (auto * b : iova_buffers) {
+        allocated += b->size();
+        if (b->mapped) mapped += b->size();
+    }
+    allocation_peak = std::max(allocation_peak, allocated);
+    for (auto * b : op_batch->buffers) if (!b->mapped) extra += b->size();
+    if (mapped + extra > max_vmem) {
+        flush_pending(true);
+        for (auto * b : iova_buffers) {
+            if (b->mapped && !op_batch->b_map.count(b->fd())) {
+                b->unmap();
+                mapped -= b->size();
+                iova_evictions++;
+            }
+        }
+    }
+    if (mapped + extra > max_vmem) GGML_ABORT("ggml-hex: operation exceeds IOVA window");
+    try {
+        for (auto * b : op_batch->buffers) if (!b->mapped) b->mmap();
+    } catch (const std::runtime_error &) {
+        // IOVA allocation may require alignment gaps not counted in byte totals.
+        // Retry once from a drained, empty window to remove fragmentation.
+        flush_pending(true);
+        for (auto * b : iova_buffers) if (b->mapped) {
+            b->unmap();
+            iova_evictions++;
+        }
+        mapped = 0;
+        extra = op_batch->b_vmem;
+        for (auto * b : op_batch->buffers) b->mmap();
+    }
+    iova_peak = std::max(iova_peak, mapped + extra);
+}

Subject: linux-v4l2: hide internal Qualcomm CAMSS endpoints

The SM-X910 exposes its raw ISP endpoints as V4L2 capture nodes for libcamera.
They are not application-ready webcams, and selecting the first one makes the
OBS V4L2 source crash after its failed setup. Hide those internal nodes while
leaving the four processed GTS9U loopback cameras visible. Also handle missing
by-id/by-path directories before the ordinary /dev scan.

--- a/plugins/linux-v4l2/v4l2-input.c
+++ b/plugins/linux-v4l2/v4l2-input.c
@@ -412,7 +412,7 @@ v4l2_device_add_devices_from(struct v4l2_device_entry *first_device,
 	struct dirent *dp;
 	struct dstr full_path;
 	const char *scanned_dir;
-	struct dirent **namelist;
+	struct dirent **namelist = NULL;
 	int no;
 
 #ifdef __FreeBSD__
@@ -449,12 +449,22 @@ v4l2_device_add_devices_from(struct v4l2_device_entry *first_device,
 				goto next_entry;
 			}
 
+			/* The Qualcomm CAMSS nodes expose raw ISP endpoints for
+			 * libcamera, not application-ready webcams. Offering one as
+			 * OBS's default device can crash the source during setup. */
+			if (strcmp((const char *)video_cap.card,
+				   "Qualcomm Camera Subsystem") == 0) {
+				blog(LOG_DEBUG, "Skipping internal CAMSS node at %s",
+				     full_path.array);
+				goto next_entry;
+			}
+
 			if (type == DEVICE_OTHER) {
 				bool device_already_added = false;
 
 				struct v4l2_device_entry *current_device =
 					first_device;
-				while (current_device->next != NULL) {
+				while (current_device != NULL) {
 					if (strncmp(real_path,
 						    current_device->real_path
 							    .array,

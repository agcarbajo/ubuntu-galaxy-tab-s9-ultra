 	/* Local parameter storage */
 	struct IPAContext context_;
@@ -430,14 +433,39 @@ std::optional<int32_t> IPASoftSimple::processFocusStats(uint64_t score)
 		return std::nullopt;
 
 	if (afPhase_ == AfPhase::Locked) {
+		/* A single-shot AF request must remain locked until retriggered. */
+		if (afMode_ != controls::AfModeContinuous)
+			return std::nullopt;

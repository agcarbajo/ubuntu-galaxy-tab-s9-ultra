--- a/pam/pam_fprintd.c
+++ b/pam/pam_fprintd.c
@@ -790,10 +790,19 @@ pam_sm_authenticate (pam_handle_t *pamh, int flags, int argc,
                      const char **argv)
 {
   const char *username;
+  const void *service = NULL;
   int i;

   bindtextdomain (GETTEXT_PACKAGE, LOCALEDIR);
   bind_textdomain_codeset (GETTEXT_PACKAGE, "UTF-8");

+  /* GDM starts a separate gdm-fingerprint PAM conversation.  If the
+   * system-wide common-auth profile also enables this module, running it
+   * from gdm-password blocks the password worker until the scan times out.
+   */
+  if (pam_get_item (pamh, PAM_SERVICE, &service) == PAM_SUCCESS &&
+      service != NULL && str_equal (service, "gdm-password"))
+    return PAM_IGNORE;
+
   if (is_remote (pamh))
     return PAM_AUTHINFO_UNAVAIL;

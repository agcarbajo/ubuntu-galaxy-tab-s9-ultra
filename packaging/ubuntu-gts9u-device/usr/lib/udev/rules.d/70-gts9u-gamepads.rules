# Chromium uses hidraw for Nintendo input and Sony controller features.
# Limit access to the actual gamepad HID IDs, on USB or Bluetooth; uaccess
# follows the active local seat. Do not grant access to arbitrary HID devices.
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", KERNELS=="*:057E:2009.*", GROUP="input", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", KERNELS=="*:054C:05C4.*", GROUP="input", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", KERNELS=="*:054C:09CC.*", GROUP="input", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", KERNELS=="*:054C:0BA0.*", GROUP="input", MODE="0660", TAG+="uaccess"

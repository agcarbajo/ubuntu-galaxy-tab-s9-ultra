[Unit]
Description=Expand the Ubuntu root filesystem to fill its partition
DefaultDependencies=no
After=systemd-remount-fs.service
Before=basic.target
ConditionPathExists=!/var/lib/ubuntu-gts9u/rootfs-grown

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/ubuntu-gts9u-grow-rootfs

[Install]
WantedBy=basic.target

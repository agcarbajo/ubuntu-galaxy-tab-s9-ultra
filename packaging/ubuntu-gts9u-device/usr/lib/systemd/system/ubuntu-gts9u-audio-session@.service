[Unit]
Description=Complete the tablet audio session for UID %i
Wants=user@%i.service
After=ubuntu-gts9u-desktop-user.service ubuntu-gts9u-adsp-boot.service alsa-restore.service user@%i.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/ubuntu-gts9u-audio-session %i
TimeoutStartSec=150
RemainAfterExit=yes

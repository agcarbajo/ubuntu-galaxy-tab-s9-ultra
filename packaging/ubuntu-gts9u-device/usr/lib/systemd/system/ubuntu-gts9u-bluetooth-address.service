[Unit]
Description=Apply the native Samsung Bluetooth address from EFS
Documentation=https://github.com/agcarbajo/postmarketos-galaxy-tab-s9-ultra
After=systemd-udev-settle.service
Before=bluetooth.service
Wants=systemd-udev-settle.service
ConditionPathExists=/dev/disk/by-partlabel/efs

[Service]
Type=oneshot
ExecStart=/usr/libexec/ubuntu-gts9u-bluetooth-address
RemainAfterExit=yes
# This unit is ordered before bluetooth.service, so anything that blocks here
# blocks the whole Bluetooth stack.  An earlier version hung in btmgmt for
# minutes and left bluetooth.service dead.  The script bounds its own calls;
# this is the backstop.
TimeoutStartSec=90

[Install]
WantedBy=bluetooth.service

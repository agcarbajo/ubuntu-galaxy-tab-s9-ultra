[Unit]
Description=Galaxy Tab fingerprint target availability broker
After=dbus.service systemd-logind.service

[Service]
Type=dbus
BusName=io.github.agcarbajo.Gts9uFingerprintUI
ExecStart=/usr/libexec/ubuntu-gts9u-fingerprint-ui
RuntimeDirectory=gts9u-fingerprint-ui
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target

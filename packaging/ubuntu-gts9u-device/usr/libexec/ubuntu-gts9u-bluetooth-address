#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Give the Bluetooth controller its real address.
#
# The WCN7850 NVM this device uses carries a null address, so hci0 comes up as
# 00:00:00:00:5A:AD, stays DOWN, and BlueZ reports "No default controller
# available".  The real address lives in the Samsung EFS partition, which is
# mounted read-only with noload -- never written, never journalled -- just long
# enough to read it.
#
# Derived from gts9uwifi-bluetooth-address of the postmarketOS port, with the
# btmgmt handling rewritten after it wedged the boot on Ubuntu.
#
# BlueZ 5.72's btmgmt blocks indefinitely when it runs before bluetoothd is up.
# Measured on this device: `btmgmt info` sat for over four minutes, and the
# unit timed out at 90 s on every boot.  Run after bluetooth.service instead
# and the same call returns in under a second.  Everything here is still
# bounded by a timeout, and the "is it already done?" probe uses hciconfig,
# which is an ioctl and answers in about 3 ms, so a regression in btmgmt can
# never wedge the boot again.
#
# Applying the address late costs nothing: an unconfigured controller is
# unusable until it has one, and bluetoothd adopts it immediately afterwards
# without needing a restart.
set -u

efs=/dev/disk/by-partlabel/efs
mountpoint=/run/ubuntu-gts9u-efs-ro
deadline=30

log() { echo "ubuntu-gts9u-bluetooth-address: $*" >&2; }

current_address() {
	# ioctl, not the management socket: cannot block.
	timeout 5 hciconfig hci0 2>/dev/null | \
		sed -n 's/.*BD Address: \([0-9A-Fa-f:]*\).*/\1/p' | head -1
}

# --- wait for the controller to exist at all ---------------------------------
i=0
while [ "$i" -lt "$deadline" ]; do
	[ -d /sys/class/bluetooth/hci0 ] && break
	sleep 1
	i=$((i + 1))
done
if [ ! -d /sys/class/bluetooth/hci0 ]; then
	log 'hci0 never appeared; leaving Bluetooth alone'
	exit 0
fi

# --- read the native address -------------------------------------------------
i=0
while [ "$i" -lt "$deadline" ]; do
	[ -b "$efs" ] && break
	sleep 1
	i=$((i + 1))
done
if [ ! -b "$efs" ]; then
	log 'EFS partition not found; cannot set the native address'
	exit 0
fi

mkdir -p "$mountpoint"
cleanup() {
	mountpoint -q "$mountpoint" && umount "$mountpoint" || true
}
trap cleanup EXIT
# ro,noload is mandatory: EFS holds per-device calibration and must never be
# written, and noload stops the kernel replaying its journal.
if ! mount -o ro,noload "$efs" "$mountpoint"; then
	log 'could not mount EFS read-only'
	exit 0
fi
address=$(tr -d '\r\n[:space:]' < "$mountpoint/bluetooth/bt_addr" 2>/dev/null)
cleanup
trap - EXIT

case "$address" in
	[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]) ;;
	*) log 'invalid native Bluetooth address in EFS'; exit 0 ;;
esac

# --- nothing to do if it is already applied ----------------------------------
if [ "$(current_address)" = "$address" ]; then
	log 'the native address is already active'
	exit 0
fi

# --- wait for the management interface to accept the controller --------------
i=0
while [ "$i" -lt "$deadline" ]; do
	if timeout 5 btmgmt config 2>/dev/null | grep -q '^hci0:'; then
		break
	fi
	sleep 1
	i=$((i + 1))
done

if ! timeout 5 btmgmt config 2>/dev/null | grep -q '^hci0:'; then
	log 'hci0 is not in the unconfigured list; not forcing an address'
	exit 0
fi

if timeout 10 btmgmt --index 0 public-addr "$address" >/dev/null 2>&1; then
	sleep 1
	log "applied the native address; hci0 is now $(current_address)"
else
	log 'btmgmt refused to set the public address'
fi
exit 0

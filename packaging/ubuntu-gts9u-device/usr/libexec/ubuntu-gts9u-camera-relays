#!/bin/bash
set -euo pipefail

sources=(
	libcamera_input._base_soc_0_geniqup_8c0000_i2c_884000_camera_21
	libcamera_input._base_soc_0_cci_ac16000_i2c-bus_1_camera_20
	libcamera_input._base_soc_0_cci_ac15000_i2c-bus_1_camera_21
	libcamera_input._base_soc_0_cci_ac15000_i2c-bus_0_camera_21
)
pids=()

stop_relays() {
	trap - TERM INT EXIT
	if [ "${#pids[@]}" -gt 0 ]; then
		kill "${pids[@]}" 2>/dev/null || true
		wait "${pids[@]}" 2>/dev/null || true
	fi
}
trap stop_relays TERM INT EXIT

# The PipeWire socket belongs to the desktop user. Waiting for both the socket
# and its service makes a cold boot deterministic without racing the owner's
# dynamically resolved user manager.
pipewire_main_pid() {
	systemctl --user show pipewire.service -p MainPID --value 2>/dev/null || true
}

pipewire_pid=
for unused in {1..30}; do
	pipewire_pid=$(pipewire_main_pid)
	if [ -S "$XDG_RUNTIME_DIR/pipewire-0" ] &&
		[ -n "$pipewire_pid" ] && [ "$pipewire_pid" != 0 ] &&
		kill -0 "$pipewire_pid" 2>/dev/null; then
		break
	fi
	sleep 1
done
[ -S "$XDG_RUNTIME_DIR/pipewire-0" ]
[ -n "$pipewire_pid" ]
[ "$pipewire_pid" != 0 ]
kill -0 "$pipewire_pid"

# 640x480 is what pipewiresrc is asked for above, so publishing 1280x960 only
# interpolated it -- and paid for the scaler, a YUY2 conversion and 73 MB/s of
# memcpy per camera, thirty times a second, forever.  Measured cost of one relay
# sitting idle with nothing reading it:
#
#   1280x960 @30, splash as it was   106.8 %  of a core
#   1280x960 @30, splash fixed        60.6 %
#    640x480 @30, splash fixed         2.2 %
#
# All four still advertise CAPTURE at 640x480, which is the resolution the frames
# actually carry.  The four together came to 235 % of a core; that was 2.4 of the
# eight cores and about 17 C, with the tablet doing nothing.
caps="video/x-raw,format=YUY2,width=640,height=480,framerate=30/1"

# The idle pipeline repeats one black frame.  Converting and scaling it *before*
# imagefreeze means that work happens once instead of on every frame; leaving it
# after the freeze was half of the idle cost above.  A 16x16 black PNG, the same
# image v4l2-relayd ships as its default.
splash="dataurisrc uri=data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAIAAACQkWg2AAAAEElEQVQoz2NgGAWjYBTAAAADEAABaJFtwwAAAABJRU5ErkJggg== ! pngdec ! videoscale ! videoconvert ! capsfilter caps=video/x-raw,format=YUY2,width=640,height=480 ! imagefreeze is-live=true"

for index in 0 1 2 3; do
	node=$((20 + index))
	input="pipewiresrc target-object=${sources[$index]} do-timestamp=true ! capsfilter caps=video/x-raw,format=RGBA,width=640,height=480 ! queue max-size-buffers=4 leaky=downstream ! videoconvert ! videoscale ! videorate ! capsfilter caps=$caps"
	output="appsrc name=appsrc is-live=true format=time block=false max-bytes=0 max-buffers=4 leaky-type=downstream caps=$caps ! videoconvert ! $caps ! v4l2sink name=v4l2sink device=/dev/video${node} sync=false"
	/usr/bin/v4l2-relayd --input "$input" --output "$output" --splash "$splash" &
	pids+=("$!")
done

# A PipeWire restart does not always surface as a fatal GStreamer error. Watch
# its real service PID explicitly so the relays cannot remain attached to a
# dead socket and silently publish black frames. Any relay exit has the same
# effect. systemd then restarts the complete set, releasing the single CAMSS
# pipeline before replacements are launched.
while true; do
	sleep 1
	if ! kill -0 "$pipewire_pid" 2>/dev/null; then
		current_pipewire_pid=$(pipewire_main_pid)
		echo "PipeWire changed from $pipewire_pid to ${current_pipewire_pid:-unavailable}; restarting relays" >&2
		exit 1
	fi
	for pid in "${pids[@]}"; do
		if ! kill -0 "$pid" 2>/dev/null; then
			echo "Camera relay $pid exited; restarting relay set" >&2
			exit 1
		fi
	done
done

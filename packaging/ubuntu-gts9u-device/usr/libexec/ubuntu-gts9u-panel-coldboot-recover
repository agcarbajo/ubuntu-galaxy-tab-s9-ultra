#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Ported from gts9uwifi-panel-coldboot-recover of the postmarketOS gts9uwifi
# port. The mechanism is a property of the hardware, not of the distribution:
# the ANA38407 is unreachable after Samsung's cold-boot hand-off, reading back
# a DCS ID of 00 00 00, and only the kernel's platform-level suspend test
# repairs it. Suspending devices alone does not: pm_test=devices returns with
# the panel still dead, while pm_test=platform brings the ID back to 80 00 04.
#
# The platform test returns on its own after the configured diagnostic pause,
# so it needs no RTC and no wake event. Its pause can be zero for this recovery.
set -eu

PM_TEST=/sys/power/pm_test
PM_STATE=/sys/power/state
PM_TEST_DELAY=/sys/module/suspend/parameters/pm_test_delay
saved_pm_test_delay=

log() {
	echo "ubuntu-gts9u-panel-coldboot-recover: $*"
}

if [ ! -w "$PM_TEST" ] || [ ! -w "$PM_STATE" ]; then
	log 'PM test interface unavailable; leaving the display state unchanged'
	exit 0
fi

if ! grep -qw platform "$PM_TEST"; then
	log 'platform test level unavailable; leaving the display state unchanged'
	exit 0
fi

restore_pm_test() {
	echo none > "$PM_TEST" 2>/dev/null || true
	if [ -n "$saved_pm_test_delay" ]; then
		echo "$saved_pm_test_delay" > "$PM_TEST_DELAY" 2>/dev/null || true
	fi
}
trap restore_pm_test EXIT INT TERM

# The platform test is a complete device/late/noirq suspend and resume even
# when its diagnostic pause is zero.  The stock five-second pause contributes
# nothing to the panel reset and only extends the black boot interval.  Keep
# the old value so normal PM diagnostics retain their configured behaviour.
if [ -w "$PM_TEST_DELAY" ]; then
	saved_pm_test_delay=$(cat "$PM_TEST_DELAY")
	echo 0 > "$PM_TEST_DELAY"
fi

attempt=1
while :; do
	freeze_before=$(cat /sys/power/suspend_stats/failed_freeze 2>/dev/null || echo 0)
	log "running the automatic platform suspend/resume cycle (attempt $attempt)"
	echo platform > "$PM_TEST"
	if echo mem > "$PM_STATE"; then
		# A successful suspend syscall does not prove that the DDIC recovered.
		# If the short test leaves its ID at zero, repeat once with the stock
		# delay before allowing the display manager to start.
		if dmesg 2>/dev/null | grep -i 'ana38407 panel id' | tail -1 | grep -q '80 00 04'; then
			break
		fi
		if [ -n "$saved_pm_test_delay" ]; then
			log 'short cycle did not recover the DDIC; retrying with the original delay'
			echo "$saved_pm_test_delay" > "$PM_TEST_DELAY"
			echo platform > "$PM_TEST"
			echo mem > "$PM_STATE"
		fi
		break
	fi
	restore_pm_test
	freeze_after=$(cat /sys/power/suspend_stats/failed_freeze 2>/dev/null || echo 0)
	# A wake event during early boot can abort the userspace freezer before
	# any device suspend callback runs, leaving the panel untouched. Retry
	# only that case; a device or UFS resume failure must remain an error.
	if [ "$freeze_after" -le "$freeze_before" ] || [ "$attempt" -ge 3 ]; then
		log 'platform cycle failed; no further automatic retry'
		exit 1
	fi
	log 'userspace freeze was aborted; retrying in two seconds'
	attempt=$((attempt + 1))
	sleep 2
done
log 'platform cycle returned'

# Report what the panel driver saw, so the journal records whether the DDIC
# actually came back rather than only that the cycle ran.
dmesg 2>/dev/null | grep -i 'ana38407 panel id' | tail -2 || true

# The DWC3 host does not survive this platform test reliably. The reference
# port recreates it here, but only when the tablet was already the USB data
# host, so a PC/RNDIS connection in device mode is left alone. That helper is
# not ported yet; this is where it goes once USB host is being validated.
if [ -x /usr/libexec/ubuntu-gts9u-usb-host-resume ]; then
	/usr/libexec/ubuntu-gts9u-usb-host-resume || true
fi

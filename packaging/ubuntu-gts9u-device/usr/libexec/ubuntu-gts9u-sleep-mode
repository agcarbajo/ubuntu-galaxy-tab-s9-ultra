#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Pick the sleep state this tablet uses, and stop the UFS resume fault from
# happening a second time.
#
# Deep suspend on this board sometimes comes back without the internal
# storage: the UFS PHY fails to calibrate, the controller never re-enables and
# ext4 drops the root filesystem to read-only until a forced restart.  Or the
# panel never comes back at all.  The cause is upstream's -- `ufs-qcom`
# declares `no_phy_retention` for every SM8550 and so forces `spm_lvl = 5`,
# tearing the PHY down on every system suspend -- and nothing here fixes it.
#
# `s2idle` never tears it down.  It costs real standby battery, which is why
# it is not the default: a tablet that has never seen the fault keeps deep
# sleep.  But a tablet that *has* seen it has already told us something about
# its own hardware, and the second occurrence is pure loss.  So the first
# failure is remembered and this tablet uses light sleep from then on.
#
# The evidence cannot be the kernel log.  Measured on 2026-11-14: the journal
# of a boot that died this way ends at "PM: suspend entry (deep)", because the
# lines that describe the failure are logged after the disk is gone.  What
# does survive is the marker ubuntu-gts9u-storage-health writes before every
# suspend and removes after every resume that found the storage healthy.  If
# it is still there at boot, the last suspend never ended well.
#
# That alone would also convict a battery that ran flat while the tablet
# slept.  The marker carries the PMIC counter, which keeps counting while the
# tablet is off, and the charge at the moment of suspending, so a suspend that
# began with charge to spare and was cut short within two days is a failed
# resume, and anything else is left alone.
#
# The owner decides in the end: remove the marker to go back to deep sleep,
# create it to stay on light sleep for good.
#
#   sudo rm /var/lib/ubuntu-gts9u/force-light-sleep     # deep sleep again
#   sudo touch /var/lib/ubuntu-gts9u/force-light-sleep  # light sleep always
set -u

STATE=${GTS9U_SLEEP_STATE:-/var/lib/ubuntu-gts9u}
CHOICE=$STATE/force-light-sleep
MARKER=$STATE/suspend-in-progress
MEM_SLEEP=${GTS9U_SLEEP_MEM_SLEEP:-/sys/power/mem_sleep}
COUNTER=${GTS9U_SLEEP_COUNTER:-/sys/class/rtc/rtc0/since_epoch}

# A suspend that began with at least this much charge did not end because the
# battery ran out, as long as it was cut short within this many seconds.
MIN_CAPACITY=20
MAX_ASLEEP=172800

note() { logger -t ubuntu-gts9u-sleep-mode "$1" 2>/dev/null || true; }

select_s2idle() {
	[ -w "$MEM_SLEEP" ] || return 1
	case " $(cat "$MEM_SLEEP" 2>/dev/null) " in
		*' [s2idle] '*) return 0 ;;        # already chosen
		*s2idle*) ;;
		*) note 'this kernel offers no s2idle state'; return 1 ;;
	esac
	printf 's2idle\n' > "$MEM_SLEEP" 2>/dev/null || return 1
	return 0
}

is_number() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	return 0
}

# Did the last suspend of the previous boot end in a restart instead of a
# resume, for a reason that was not the battery?
failed_resume() {
	[ -f "$MARKER" ] || return 1
	began='' capacity=''
	read -r began capacity < "$MARKER" || true
	rm -f -- "$MARKER" 2>/dev/null       # one verdict per marker
	now=''
	[ -r "$COUNTER" ] && read -r now < "$COUNTER"
	if ! is_number "$began" || ! is_number "$capacity" || ! is_number "$now"; then
		note 'a suspend never ended, but its marker cannot be read; ignoring it'
		return 1
	fi
	if [ "$capacity" -lt "$MIN_CAPACITY" ]; then
		note "a suspend never ended, but it began at $capacity% charge; the battery may simply have run out"
		return 1
	fi
	if [ "$now" -lt "$began" ] || [ $((now - began)) -gt "$MAX_ASLEEP" ]; then
		note 'a suspend never ended, but too long ago to tell a failed resume from a flat battery'
		return 1
	fi
	note "the last suspend began at $capacity% charge and ended in a restart $((now - began)) s later, not in a resume"
	return 0
}

if [ -e "$CHOICE" ]; then
	rm -f -- "$MARKER" 2>/dev/null
	if select_s2idle; then
		note 'light sleep selected: this tablet has failed to resume from deep sleep before'
	else
		note 'could not select light sleep'
	fi
	exit 0
fi

failed_resume || exit 0

mkdir -p "$STATE" 2>/dev/null || true
if : > "$CHOICE" 2>/dev/null; then
	note 'remembering light sleep for this tablet; remove '"$CHOICE"' to go back to deep sleep'
else
	note 'light sleep could not be remembered: the marker could not be written'
fi
if select_s2idle; then
	note 'light sleep selected for this boot'
fi
exit 0

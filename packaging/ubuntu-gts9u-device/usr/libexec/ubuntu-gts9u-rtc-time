#!/usr/bin/python3
"""Use the PMIC's continuing counter without changing Android's RTC epoch.

Samsung stores its UTC offset in Android's encrypted data. Keep Ubuntu's own
counter/UTC anchor after synchronization instead of writing that shared RTC.
"""
import argparse
import json
from pathlib import Path
import os
import subprocess
import time

STATE = Path('/var/lib/gts9u-rtc-time/anchor.json')
RESTORED = Path('/run/gts9u-rtc-time-restored')
COUNTER = Path('/sys/class/rtc/rtc0/since_epoch')


def restore_value(anchor, counter):
    """The UTC to set, and how it was reached: 'counter' or 'anchor'.

    The PMIC counter is monotonic across both operating systems, so the
    anchor plus its advance is the real time.  It restarts, though -- a
    battery pull, a PMIC reset, and the forced restarts this board needs
    after a storage resume failure are all candidates -- and then the delta
    is negative or absurd.  That used to raise, the unit failed, and the
    tablet sat in 1970 until a network arrived: every certificate expired,
    APT refused its own archive and the clock was out by fifty-six years.
    The last known time is out by however long the tablet was off, which is
    the better of the two wrongs and the one systemd itself falls back to.
    """
    if anchor['utc'] < 1735689600:
        raise ValueError('No trusted UTC anchor')
    delta = counter - anchor['counter']
    if 0 <= delta <= 10 * 366 * 86400:
        return anchor['utc'] + delta, 'counter'
    return anchor['utc'], 'anchor'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--restore', action='store_true')
    parser.add_argument('--save', action='store_true')
    args = parser.parse_args()
    if not COUNTER.exists():
        print('PMIC RTC is not available')
        return
    counter = int(COUNTER.read_text())
    if args.restore:
        if not STATE.exists():
            print('UTC anchor will be saved after the first network synchronization')
            return
        try:
            value, how = restore_value(json.loads(STATE.read_text()), counter)
        except (ValueError, KeyError, TypeError) as error:
            # Never fail the boot over the clock: without this the unit went
            # down and nothing else tried.
            print('No usable UTC anchor (%s); leaving the clock to the network'
                  % error)
            return
        time.clock_settime(time.CLOCK_REALTIME, value)
        RESTORED.touch()
        if how == 'counter':
            print('Restored UTC from the continuing PMIC counter')
        else:
            print('The PMIC counter restarted; restored the last known UTC '
                  '(%s) instead of leaving the tablet in 1970'
                  % time.strftime('%Y-%m-%d %H:%M:%S', time.gmtime(value)))
    elif args.save:
        synced = subprocess.check_output(['timedatectl', 'show', '-p', 'NTPSynchronized', '--value'], text=True).strip() == 'yes'
        if not synced and not RESTORED.exists():
            print('No trusted UTC to save')
            return
        value = time.time()
        if value < 1735689600:
            raise ValueError('Refusing an invalid UTC anchor')
        STATE.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
        temporary = STATE.with_suffix('.new')
        temporary.write_text(json.dumps({'counter': counter, 'utc': value}) + '\n')
        temporary.chmod(0o600)
        with temporary.open('rb') as stream:
            os.fsync(stream.fileno())
        temporary.replace(STATE)


if __name__ == '__main__':
    main()

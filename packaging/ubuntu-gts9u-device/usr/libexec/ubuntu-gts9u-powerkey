#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Power button: a short press suspends, a long press asks before shutting down.

Neither logind nor GNOME can do this on its own.  logind can tell a short press
from a long one but can only run its own fixed actions, none of which is "show
GNOME's shutdown dialog".  GNOME can show that dialog but treats every press
the same.  Splitting the key between them produces conflicts - both act on the
same press - so this takes ownership of the key and both halves live here.

For that to hold, the other two owners are told to keep their hands off:

  * logind, through HandlePowerKey=ignore and HandlePowerKeyLongPress=ignore;
  * gnome-settings-daemon, through power-button-action='nothing'.

The long press invokes org.gnome.SessionManager.Shutdown on the active user's
session bus, which is the same call gnome-session-quit --power-off makes: the
dialog with the sixty second countdown, not an immediate power off.
"""
import os
import re
import select
import struct
import subprocess
import sys
import time

KEY_POWER = 116
EV_KEY = 1

# Held for longer than this and it is a long press.  Short enough to feel
# deliberate, long enough that nobody triggers it while meaning to suspend.
LONG_PRESS_MS = 1200

# A wake press is queued in evdev and reaches us after userspace thaws. Identify
# it from both the time spent in suspend and the kernel's recorded wake IRQ.
# A plain monotonic timeout also swallows a second press made while the desktop
# is still entering suspend.
MIN_SLEEP_S = 0.05
PM_WAKEUP_IRQ = "/sys/power/pm_wakeup_irq"

EVENT_FORMAT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)


def log(message):
    print("ubuntu-gts9u-powerkey: %s" % message, flush=True)


def find_power_key():
    """Locate the PMIC power key by name, not by a fixed event number."""
    try:
        with open("/proc/bus/input/devices") as handle:
            blocks = handle.read().split("\n\n")
    except OSError as exc:
        log("cannot read the input device list: %s" % exc)
        return None

    for block in blocks:
        if 'Name="pmic_pwrkey"' not in block:
            continue
        match = re.search(r"(event\d+)", block)
        if match:
            return "/dev/input/" + match.group(1)
    return None


def active_session():
    """The uid and name of the user whose graphical session is in front."""
    try:
        out = subprocess.check_output(
            ["loginctl", "list-sessions", "--no-legend"],
            text=True, timeout=5)
    except (OSError, subprocess.SubprocessError) as exc:
        log("cannot list sessions: %s" % exc)
        return None

    for line in out.splitlines():
        fields = line.split()
        if len(fields) < 3:
            continue
        session, uid, user = fields[0], fields[1], fields[2]
        try:
            state = subprocess.check_output(
                ["loginctl", "show-session", session, "-p", "Active",
                 "--value"], text=True, timeout=5).strip()
        except (OSError, subprocess.SubprocessError):
            continue
        if state == "yes":
            return uid, user
    return None


def short_press():
    log("short press: suspending")
    subprocess.Popen(["systemctl", "suspend"])
    return time.monotonic(), time.clock_gettime(time.CLOCK_BOOTTIME)


def power_key_irq():
    """Return the Linux IRQ used by pmic_pwrkey on this boot."""
    try:
        with open("/proc/interrupts") as handle:
            for line in handle:
                if "pmic_pwrkey" in line:
                    return int(line.split(":", 1)[0].strip())
    except (OSError, ValueError):
        pass
    return None


def wake_irq():
    try:
        with open(PM_WAKEUP_IRQ) as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return None


def slept_since(stamp):
    monotonic_at, boottime_at = stamp
    awake_elapsed = time.monotonic() - monotonic_at
    total_elapsed = time.clock_gettime(time.CLOCK_BOOTTIME) - boottime_at
    return max(0.0, total_elapsed - awake_elapsed)


def suspend_offset():
    """Time accumulated outside CLOCK_MONOTONIC, including system suspend."""
    return time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()


def cancel_pending_suspend():
    """Cancel the transaction when power is pressed during suspend entry."""
    log("power press during suspend entry: cancelling suspend")
    subprocess.Popen(
        ["systemctl", "stop", "suspend.target", "systemd-suspend.service"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def long_press():
    who = active_session()
    if who is None:
        # No desktop to ask.  Do nothing rather than power off behind the
        # owner's back; holding the button longer still reaches the PMIC.
        log("long press: no active session, ignoring")
        return
    uid, user = who
    log("long press: asking %s to confirm shutdown" % user)
    subprocess.Popen(
        ["runuser", "-u", user, "--",
         "env", "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%s/bus" % uid,
         "gdbus", "call", "--session",
         "--dest", "org.gnome.SessionManager",
         "--object-path", "/org/gnome/SessionManager",
         "--method", "org.gnome.SessionManager.Shutdown"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    path = find_power_key()
    if path is None:
        log("no pmic_pwrkey input device; nothing to do")
        return 1
    log("watching %s (long press at %d ms)" % (path, LONG_PRESS_MS))
    pwr_irq = power_key_irq()
    log("pmic power-key wake IRQ is %s" %
        (pwr_irq if pwr_irq is not None else "unknown"))

    with open(path, "rb", buffering=0) as dev:
        pressed_at = None
        fired = False
        suspended_at = None
        last_suspend_offset = suspend_offset()
        while True:
            # When the key is down, wake up in time to fire the long press
            # without waiting for the release.
            timeout = None
            if pressed_at is not None and not fired:
                remaining = LONG_PRESS_MS / 1000.0 - (time.monotonic() - pressed_at)
                timeout = max(remaining, 0)

            ready, _, _ = select.select([dev], [], [], timeout)

            if not ready:
                if pressed_at is not None and not fired:
                    fired = True
                    long_press()
                continue

            data = dev.read(EVENT_SIZE)
            if not data or len(data) < EVENT_SIZE:
                continue
            _, _, etype, code, value = struct.unpack(EVENT_FORMAT, data)
            if etype != EV_KEY or code != KEY_POWER:
                continue

            # This also detects a suspend requested by systemd, GNOME or a
            # diagnostic tool. Without it, the wake press from such a sleep
            # looks like a fresh short press and tries to suspend once more.
            current_suspend_offset = suspend_offset()
            externally_observed_sleep = max(
                0.0, current_suspend_offset - last_suspend_offset)
            last_suspend_offset = current_suspend_offset

            if value == 1:              # down
                now = time.monotonic()
                irq = wake_irq()
                if (externally_observed_sleep >= MIN_SLEEP_S and
                        irq == pwr_irq):
                    log("ignoring the press that woke us "
                        "(observed %.3f s asleep, IRQ %s)" %
                        (externally_observed_sleep, irq))
                    suspended_at = None
                    pressed_at = None
                    fired = True        # swallow the matching release too
                    continue
                if suspended_at is not None:
                    slept = slept_since(suspended_at)
                    if slept >= MIN_SLEEP_S and irq == pwr_irq:
                        log("ignoring the press that woke us "
                            "(slept %.3f s, IRQ %s)" % (slept, irq))
                        suspended_at = None
                        pressed_at = None
                        fired = True    # swallow the matching release too
                        continue
                    if slept < MIN_SLEEP_S:
                        cancel_pending_suspend()
                        suspended_at = None
                        pressed_at = None
                        fired = True    # swallow the matching release too
                        continue
                    # The machine woke for another source. This is a fresh
                    # power-key command even if it follows resume closely.
                    log("new press after non-key wake (slept %.3f s, IRQ %s)" %
                        (slept, irq if irq is not None else "unknown"))
                    suspended_at = None
                pressed_at = now
                fired = False
            elif value == 0:            # up
                if pressed_at is not None and not fired:
                    suspended_at = short_press()
                pressed_at = None
                fired = False
            # value == 2 is autorepeat; the timer already covers the long press


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)

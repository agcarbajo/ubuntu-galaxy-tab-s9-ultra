 static void
 input_pipeline_disable ()
 {
-  if (input_pipeline != NULL)
-    gst_element_set_state (input_pipeline, GST_STATE_NULL);
-  if (input_pipeline != NULL)
-    gst_element_set_state (splash_pipeline, GST_STATE_PLAYING);
+  /* v4l2-ctl and browsers may briefly close the node while negotiating.
+   * Coalesce those transitions, but release libcamera between real clients. */
+  if (input_disable_timeout_id == 0)
+    input_disable_timeout_id = g_timeout_add (500, input_pipeline_destroy, NULL);
 }
 

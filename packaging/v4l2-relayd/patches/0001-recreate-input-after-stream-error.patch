Subject: relayd: serialize and recreate camera input pipelines

All four logical cameras share the tablet's single CAMSS/ISP path. Serialize
their active PipeWire inputs with an advisory lock. Coalesce short V4L2 probe
gaps for 500 ms, then destroy the input so the next application gets a fresh
connection instead of stale state. Failed inputs are dropped immediately.

--- a/src/v4l2-relayd.c
+++ b/src/v4l2-relayd.c
@@ -16,7 +16,9 @@
 #endif
 
 #include <errno.h>
+#include <fcntl.h>
 #include <unistd.h>
+#include <sys/file.h>
 #include <sys/ioctl.h>
 #include <linux/videodev2.h>
 
@@ -46,9 +48,13 @@ static gchar *opt_splash =
 
 static GMainLoop *loop = NULL;
 static guint input_bus_watch_id = 0;
+static guint input_disable_timeout_id = 0;
 static guint output_bus_watch_id = 0;
 static guint splash_bus_watch_id = 0;
 static guint v4l2_event_poll_id = 0;
+static int input_lock_fd = -1;
+static GMutex output_pts_lock;
+static GstClockTime output_next_pts = 0;
 static GstElement *input_pipeline = NULL;
 static GstElement *output_pipeline = NULL;
 static GstElement *splash_pipeline = NULL;
@@ -147,6 +151,23 @@ backend_pipeline_bus_call (GstBus     *bus,
       g_error_free (error);
 
       gst_element_set_state (pipeline, GST_STATE_NULL);
+      if (pipeline == input_pipeline) {
+        if (input_disable_timeout_id != 0) {
+          g_source_remove (input_disable_timeout_id);
+          input_disable_timeout_id = 0;
+        }
+        input_pipeline = NULL;
+        input_bus_watch_id = 0;
+        gst_object_unref (pipeline);
+        if (input_lock_fd >= 0) {
+          /* A failed PipeWire input can still have CAMSS callbacks in
+           * flight. Releasing the next camera immediately lets those
+           * callbacks overlap and eventually crashes PipeWire. */
+          g_usleep (750000);
+          flock (input_lock_fd, LOCK_UN);
+        }
+        return FALSE;
+      }
       break;
     }
     default:
@@ -165,14 +188,27 @@ backend_appsink_new_sample (GstAppSink *appsink,
   GstBuffer *buffer;
 
   sample = gst_app_sink_pull_sample (appsink);
+  if (sample == NULL)
+    return GST_FLOW_EOS;
   buffer = gst_sample_get_buffer (sample);
-  /* gst_app_src_push_buffer wants to take the ownership of the buffer,
-   * so it must hold an additional reference first. */
-  gst_buffer_ref (buffer);
-  gst_app_src_push_buffer (appsrc, buffer);
+  /* The input and output pipelines do not share a running time. Copy the
+   * camera frame and give every output buffer a stable 30 fps timeline. */
+  buffer = gst_buffer_copy_deep (buffer);
   gst_sample_unref (sample);
 
-  return GST_FLOW_OK;
+  if (buffer == NULL)
+    return GST_FLOW_ERROR;
+
+  g_mutex_lock (&output_pts_lock);
+  GST_BUFFER_PTS (buffer) = output_next_pts;
+  GST_BUFFER_DTS (buffer) = output_next_pts;
+  GST_BUFFER_DURATION (buffer) = gst_util_uint64_scale_int (GST_SECOND, 1, 30);
+  output_next_pts += GST_BUFFER_DURATION (buffer);
+  g_mutex_unlock (&output_pts_lock);
+  GST_BUFFER_OFFSET (buffer) = GST_BUFFER_OFFSET_NONE;
+  GST_BUFFER_OFFSET_END (buffer) = GST_BUFFER_OFFSET_NONE;
+
+  return gst_app_src_push_buffer (appsrc, buffer);
 }
 

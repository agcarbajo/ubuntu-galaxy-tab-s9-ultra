From 2eb32cdf9ec3468f94032cd4c244e94a7fa20738 Mon Sep 17 00:00:00 2001
From: Ubuntu gts9uwifi port contributors <noreply@example.invalid>
Date: Sun, 9 Aug 2026 06:12:00 +0200
Subject: [PATCH] libcamera: suppress redundant gts9u video transform

All four SM-X910 camera pipelines already deliver buffers in the screen-native
orientation. Advertising the sensor mounting rotation a second time makes
metadata-aware clients rotate three working streams by 90 degrees, while
clients that consume the buffers directly display all four correctly.
---
 spa/plugins/libcamera/libcamera-utils.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/spa/plugins/libcamera/libcamera-utils.cpp b/spa/plugins/libcamera/libcamera-utils.cpp
index 21ef55b6b..92500466c 100644
--- a/spa/plugins/libcamera/libcamera-utils.cpp
+++ b/spa/plugins/libcamera/libcamera-utils.cpp
@@ -826,9 +826,9 @@ mmap_init(struct impl *impl, struct port *port,
 		b->videotransform = (struct spa_meta_videotransform*)spa_buffer_find_meta_data(
 			buffers[i], SPA_META_VideoTransform, sizeof(*b->videotransform));
 		if (b->videotransform) {
-			b->videotransform->transform =
-				libcamera_orientation_to_spa_transform_value(impl->config->orientation);
+			/* The gts9u software ISP already outputs screen-native buffers. */
+			b->videotransform->transform = SPA_META_TRANSFORMATION_None;
 			spa_log_debug(impl->log, "Setting videotransform for buffer %u to %u",
 				i, b->videotransform->transform);
 
 		}
-- 

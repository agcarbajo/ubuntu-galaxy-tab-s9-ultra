#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Pair the bundled S Pen through its dock-initiated BlueZ flow."""

from glob import glob
from pathlib import Path
import time

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib


BLUEZ = "org.bluez"
BUS_NAME = "io.github.agcarbajo.TabCompanion.SPenPairing"
OBJECT_PATH = "/io/github/agcarbajo/TabCompanion/SPenPairing"
AGENT_PATH = "/io/github/agcarbajo/TabCompanion/SpenAgent"
STATE_PATH = Path("/var/lib/tab-companion/spen-remote-enabled")
DEVICE_IFACE = "org.bluez.Device1"
ADAPTER_IFACE = "org.bluez.Adapter1"
PROPERTIES_IFACE = "org.freedesktop.DBus.Properties"
SPEN_SERVICES = {
    "0000fd6c-0000-1000-8000-00805f9b34fb",
    "0000fef5-0000-1000-8000-00805f9b34fb",
}


def is_spen(properties):
    name = str(properties.get("Alias") or properties.get("Name") or "")
    services = {str(uuid).lower() for uuid in properties.get("UUIDs", [])}
    return name.startswith("SPEN") and SPEN_SERVICES <= services


class Agent(dbus.service.Object):
    def __init__(self, service):
        super().__init__(service.bus, AGENT_PATH)
        self.service = service

    def _accept(self, device):
        if not self.service.acceptable(device):
            raise dbus.DBusException(
                "Pairing request is not from the docked S Pen",
                name="org.bluez.Error.Rejected",
            )

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Release(self):
        pass

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="s")
    def RequestPinCode(self, device):
        self._accept(device)
        return "0000"

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        self._accept(device)
        return dbus.UInt32(0)

    @dbus.service.method("org.bluez.Agent1", in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, _passkey, _entered):
        self._accept(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device, _pincode):
        self._accept(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, _passkey):
        self._accept(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        self._accept(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def AuthorizeService(self, device, _uuid):
        self._accept(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        pass


class PairingService(dbus.service.Object):
    def __init__(self):
        self.bus = dbus.SystemBus()
        self.bus_name = dbus.service.BusName(BUS_NAME, bus=self.bus)
        super().__init__(self.bus_name, OBJECT_PATH)
        self.remote_enabled = self._load_remote_enabled()
        self.manager = dbus.Interface(
            self.bus.get_object(BLUEZ, "/"),
            "org.freedesktop.DBus.ObjectManager",
        )
        objects = self.manager.GetManagedObjects()
        self.adapter_path = next(
            path for path, interfaces in objects.items() if ADAPTER_IFACE in interfaces
        )
        adapter_object = self.bus.get_object(BLUEZ, self.adapter_path)
        self.adapter = dbus.Interface(adapter_object, ADAPTER_IFACE)
        self.adapter_properties = dbus.Interface(adapter_object, PROPERTIES_IFACE)
        self.agent = Agent(self)
        self.agent_manager = dbus.Interface(
            self.bus.get_object(BLUEZ, "/org/bluez"), "org.bluez.AgentManager1"
        )
        self.agent_registered = False
        self.reset_path = self._find_reset_path()
        self.reset_for_dock = False
        self.pairing = False
        self.pairing_deadline = 0.0
        self.pairable_before = False
        self.candidate = None
        self.connecting = set()
        self.connect_failures = {}
        self.repairing_bond = False
        self.next_connect = 0.0
        self.started_discovery = False
        self.bus.add_signal_receiver(
            self.interfaces_added,
            dbus_interface="org.freedesktop.DBus.ObjectManager",
            signal_name="InterfacesAdded",
        )
        self.bus.add_signal_receiver(
            self.properties_changed,
            dbus_interface=PROPERTIES_IFACE,
            signal_name="PropertiesChanged",
            path_keyword="path",
        )

    @staticmethod
    def _load_remote_enabled():
        try:
            return STATE_PATH.read_text(encoding="ascii").strip() != "0"
        except OSError:
            return True

    def _save_remote_enabled(self):
        STATE_PATH.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        STATE_PATH.write_text("1\n" if self.remote_enabled else "0\n", encoding="ascii")

    @dbus.service.method(BUS_NAME, in_signature="b", out_signature="b")
    def SetRemoteEnabled(self, enabled):
        enabled = bool(enabled)
        if enabled == self.remote_enabled:
            return True
        self.remote_enabled = enabled
        self._save_remote_enabled()
        self.finish_pairing()
        self.connecting.clear()
        self.next_connect = 0.0
        if not enabled:
            self.disconnect_spen()
            print("S Pen Bluetooth remote features disabled", flush=True)
        else:
            print("S Pen Bluetooth remote features enabled", flush=True)
            GLib.idle_add(self.tick)
        return True

    @staticmethod
    def _find_reset_path():
        matches = glob("/sys/bus/i2c/devices/*/pen_ble_reset")
        return Path(matches[0]) if matches else None

    @staticmethod
    def docked():
        matches = glob("/sys/bus/i2c/devices/*/pen_docked")
        if not matches:
            return False
        try:
            return Path(matches[0]).read_text(encoding="ascii").strip() == "1"
        except OSError:
            return False

    def devices(self):
        return {
            path: interfaces[DEVICE_IFACE]
            for path, interfaces in self.manager.GetManagedObjects().items()
            if DEVICE_IFACE in interfaces
        }

    def paired_spen(self):
        return next(
            (
                (path, properties)
                for path, properties in self.devices().items()
                if properties.get("Paired", False) and is_spen(properties)
            ),
            (None, None),
        )

    def acceptable(self, path):
        properties = self.devices().get(path)
        return (
            properties is not None
            and self.remote_enabled
            and is_spen(properties)
            and (properties.get("Paired", False) or (self.pairing and self.docked()))
            and (self.candidate in {None, path} or properties.get("Paired", False))
        )

    def connect(self, path):
        if not self.remote_enabled:
            return
        now = time.monotonic()
        if path in self.connecting or now < self.next_connect:
            return
        self.next_connect = now + 8
        self.connecting.add(path)

        def finished(*_args):
            self.connecting.discard(path)
            self.connect_failures.pop(path, None)
            self.repairing_bond = False

        def failed(error):
            self.connecting.discard(path)
            name = error.get_dbus_name()
            if name not in {
                "org.bluez.Error.AlreadyConnected",
                "org.bluez.Error.InProgress",
                "org.freedesktop.DBus.Error.NoReply",
            }:
                print(f"S Pen connect failed: {name}", flush=True)
                if self.docked() and not self.pairing and not self.repairing_bond:
                    failures = self.connect_failures.get(path, 0) + 1
                    self.connect_failures[path] = failures
                    if failures >= 4:
                        GLib.idle_add(self.repair_stale_bond, path)

        dbus.Interface(self.bus.get_object(BLUEZ, path), DEVICE_IFACE).Connect(
            reply_handler=finished,
            error_handler=failed,
        )

    def disconnect_spen(self):
        for path, properties in self.devices().items():
            if not is_spen(properties) or not properties.get("Connected", False):
                continue
            try:
                dbus.Interface(
                    self.bus.get_object(BLUEZ, path), DEVICE_IFACE
                ).Disconnect()
            except dbus.DBusException as error:
                if error.get_dbus_name() != "org.bluez.Error.NotConnected":
                    print(f"S Pen disconnect failed: {error.get_dbus_name()}", flush=True)

    def repair_stale_bond(self, path):
        """Replace a host bond which the docked pen no longer recognises."""
        if not self.remote_enabled or self.repairing_bond or not self.docked():
            return GLib.SOURCE_REMOVE
        properties = self.devices().get(path)
        if properties is None or not properties.get("Paired", False):
            return GLib.SOURCE_REMOVE
        self.repairing_bond = True
        self.connect_failures.pop(path, None)
        self.finish_pairing()
        try:
            self.adapter.RemoveDevice(dbus.ObjectPath(path))
        except dbus.DBusException as error:
            print(
                f"Could not remove stale S Pen bond: {error.get_dbus_name()}",
                flush=True,
            )
            self.repairing_bond = False
            return GLib.SOURCE_REMOVE
        print("Stale S Pen bond removed; starting dock pairing again", flush=True)
        GLib.timeout_add_seconds(1, self.restart_pairing_after_repair)
        return GLib.SOURCE_REMOVE

    def restart_pairing_after_repair(self):
        if not self.docked():
            self.repairing_bond = False
            return GLib.SOURCE_REMOVE
        self.reset_for_dock = True
        self.begin_pairing()
        if not self.pairing:
            self.repairing_bond = False
        return GLib.SOURCE_REMOVE

    def register_agent(self):
        if self.agent_registered:
            return
        self.agent_manager.RegisterAgent(AGENT_PATH, "DisplayYesNo")
        self.agent_manager.RequestDefaultAgent(AGENT_PATH)
        self.agent_registered = True

    def begin_pairing(self):
        if not self.remote_enabled:
            return
        if self.reset_path is None:
            self.reset_path = self._find_reset_path()
        if self.reset_path is None:
            return
        self.pairable_before = bool(
            self.adapter_properties.Get(ADAPTER_IFACE, "Pairable")
        )
        self.adapter_properties.Set(ADAPTER_IFACE, "Powered", dbus.Boolean(True))
        self.adapter_properties.Set(ADAPTER_IFACE, "Pairable", dbus.Boolean(True))
        self.register_agent()
        try:
            self.adapter.StartDiscovery()
            self.started_discovery = True
        except dbus.DBusException as error:
            if error.get_dbus_name() != "org.bluez.Error.InProgress":
                raise
        self.pairing = True
        self.pairing_deadline = time.monotonic() + 65
        self.candidate = None
        try:
            self.reset_path.write_text("1\n", encoding="ascii")
        except OSError as error:
            print(f"S Pen pairing reset failed: {error}", flush=True)
            self.finish_pairing()
            return
        print("S Pen dock pairing window started", flush=True)

    def finish_pairing(self):
        if self.started_discovery:
            try:
                self.adapter.StopDiscovery()
            except dbus.DBusException:
                pass
            self.started_discovery = False
        if self.pairing:
            self.adapter_properties.Set(
                ADAPTER_IFACE, "Pairable", dbus.Boolean(self.pairable_before)
            )
        self.pairing = False
        self.pairing_deadline = 0.0
        self.candidate = None
        if self.agent_registered:
            try:
                self.agent_manager.UnregisterAgent(AGENT_PATH)
            except dbus.DBusException:
                pass
            self.agent_registered = False

    def consider(self, path, properties):
        if not self.remote_enabled or not is_spen(properties):
            return
        if properties.get("Paired", False):
            if properties.get("Connected", False):
                self.connect_failures.pop(path, None)
                self.repairing_bond = False
            dbus.Interface(
                self.bus.get_object(BLUEZ, path), PROPERTIES_IFACE
            ).Set(DEVICE_IFACE, "Trusted", dbus.Boolean(True))
            self.finish_pairing()
            # The pen only advertises reliably after the garage wakes it.  A
            # disconnected, undocked bond is the normal sleeping state; do
            # not waste power or flood the journal with impossible retries.
            if not properties.get("Connected", False) and self.docked():
                self.connect(path)
            return
        if self.pairing and self.docked():
            self.candidate = path
            self.connect(path)

    def interfaces_added(self, path, interfaces):
        if DEVICE_IFACE in interfaces:
            self.consider(path, interfaces[DEVICE_IFACE])

    def properties_changed(self, interface, _changed, _invalidated, path=None):
        if interface != DEVICE_IFACE:
            return
        properties = self.devices().get(path)
        if properties is not None:
            self.consider(path, properties)

    def tick(self):
        docked = self.docked()
        if not self.remote_enabled:
            self.finish_pairing()
            self.reset_for_dock = docked
            self.disconnect_spen()
            return GLib.SOURCE_CONTINUE
        paired_path, paired = self.paired_spen()
        if self.pairing and time.monotonic() >= self.pairing_deadline:
            self.finish_pairing()
        elif self.pairing and docked:
            # BlueZ can recreate the device immediately after RemoveDevice,
            # before our InterfacesAdded receiver is ready to act on it.  Scan
            # the current object set throughout the bounded pairing window so
            # an already-visible, unpaired S Pen cannot be stranded there.
            for path, properties in self.devices().items():
                self.consider(path, properties)
        if paired_path is not None:
            self.reset_for_dock = docked
            self.consider(paired_path, paired)
        elif docked and not self.reset_for_dock:
            self.reset_for_dock = True
            self.begin_pairing()
        elif not docked:
            self.reset_for_dock = False
            self.finish_pairing()
        return GLib.SOURCE_CONTINUE

    def close(self):
        self.finish_pairing()


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    while True:
        try:
            service = PairingService()
            break
        except (StopIteration, dbus.DBusException):
            print("Waiting for the Bluetooth adapter", flush=True)
            time.sleep(2)
    service.tick()
    GLib.timeout_add_seconds(2, service.tick)
    try:
        GLib.MainLoop().run()
    finally:
        service.close()


if __name__ == "__main__":
    main()

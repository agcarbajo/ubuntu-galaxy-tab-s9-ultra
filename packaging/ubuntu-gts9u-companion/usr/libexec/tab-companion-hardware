}


def read_text(path, fallback=""):
    try:
        return Path(path).read_text(encoding="ascii").strip()
    except (OSError, UnicodeError):
        return fallback


def classify_spen_motion(points):
    """Classify Samsung's incremental dx/dy samples from one button hold."""
    if len(points) < 5:
        return None
    sum_x = sum(point[0] for point in points)
    sum_y = sum(point[1] for point in points)
    abs_x = sum(abs(point[0]) for point in points)
    abs_y = sum(abs(point[1]) for point in points)
    if abs_x + abs_y < 300:
        return None

    x = 0
    y = 0
    area2 = 0
    for dx, dy in points:
        next_x = x + dx
        next_y = y + dy
        area2 += x * next_y - next_x * y
        x = next_x
        y = next_y

    # A circle covers both axes and encloses far more signed area than a swipe.
    if min(abs_x, abs_y) > 1000 and abs(area2) > 500000:
        return (
            "gesture-circle-clockwise"
            if area2 > 0
            else "gesture-circle-counterclockwise"
        )
    if abs_x > abs_y:
        if abs(sum_x) < 80:
            return None
        return "gesture-swipe-right" if sum_x > 0 else "gesture-swipe-left"
    if abs(sum_y) < 80:
        return None
    return "gesture-swipe-down" if sum_y > 0 else "gesture-swipe-up"


class VirtualKeyboard:
    def __init__(self):
        self.fd = os.open("/dev/uinput", os.O_RDWR | os.O_NONBLOCK)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_SW)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_LED)
        for code in range(1, KEY_MAX + 1):
            fcntl.ioctl(self.fd, UI_SET_KEYBIT, code)
        fcntl.ioctl(self.fd, UI_SET_SWBIT, SW_LID)
        fcntl.ioctl(self.fd, UI_SET_LEDBIT, LED_CAPSL)
        name = b"Tab Companion virtual keyboard".ljust(80, b"\0")
        setup = struct.pack("HHHH80sI", 0x03, 0x04E8, 0xA036, 1, name, 0)
        fcntl.ioctl(self.fd, UI_DEV_SETUP, setup)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)

    def emit(self, event_type, code, value):
        os.write(self.fd, INPUT_EVENT.pack(0, 0, event_type, code, value))

    def tap(self, code):
        self.chord((code,))

    def chord(self, codes):
        for code in codes:
            self.emit(EV_KEY, code, 1)
        self.emit(EV_SYN, SYN_REPORT, 0)
        for code in reversed(codes):
            self.emit(EV_KEY, code, 0)
        self.emit(EV_SYN, SYN_REPORT, 0)

    def read_output(self):
        try:
            return os.read(self.fd, INPUT_EVENT.size * 8)
        except BlockingIOError:
            return b""

    def close(self):
        if self.fd is not None:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
            os.close(self.fd)
            self.fd = None


class VirtualPointer:
    """Relative pointer fed by the S Pen's BLE gyroscope deltas."""

    def __init__(self):
        self.fd = os.open("/dev/uinput", os.O_RDWR | os.O_NONBLOCK)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_REL)
        fcntl.ioctl(self.fd, UI_SET_KEYBIT, BTN_LEFT)
        fcntl.ioctl(self.fd, UI_SET_RELBIT, REL_X)
        fcntl.ioctl(self.fd, UI_SET_RELBIT, REL_Y)
        name = b"Tab Companion S Pen pointer".ljust(80, b"\0")
        setup = struct.pack("HHHH80sI", 0x03, 0x04E8, 0xA037, 1, name, 0)
        fcntl.ioctl(self.fd, UI_DEV_SETUP, setup)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)

    def emit(self, event_type, code, value):
        os.write(self.fd, INPUT_EVENT.pack(0, 0, event_type, code, value))

    def move(self, dx, dy):
        if dx:
            self.emit(EV_REL, REL_X, dx)
        if dy:
            self.emit(EV_REL, REL_Y, dy)
        if dx or dy:
            self.emit(EV_SYN, SYN_REPORT, 0)

    def button(self, pressed):
        self.emit(EV_KEY, BTN_LEFT, int(pressed))
        self.emit(EV_SYN, SYN_REPORT, 0)

    def close(self):
        if self.fd is not None:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
            os.close(self.fd)
            self.fd = None


class ForceFeedback:
    """Small evdev FF_RUMBLE client for the board's gpio-vibrator."""

    def __init__(self):
        self.fd = None
        self.effect_id = -1
        for event in glob("/sys/class/input/event*"):
            name = read_text(Path(event) / "device/name").lower()
            if "vibrator" not in name:
                continue
            try:
                self.fd = os.open(
                    "/dev/input/" + Path(event).name,
                    os.O_RDWR | os.O_NONBLOCK,
                )
                break
            except OSError:
                continue

    @property
    def available(self):
        return self.fd is not None

    def vibrate(self, duration_ms, magnitude):
        if self.fd is None:
            return False
        duration_ms = min(5000, max(1, int(duration_ms)))
        magnitude = min(65535, max(1, int(magnitude)))
        effect = bytearray(struct.pack(
            "<HhHHHHH2xHH28x",
            FF_RUMBLE, self.effect_id, 0, 0, 0, duration_ms, 0,
            magnitude, 0,
        ))
        try:
            fcntl.ioctl(self.fd, EVIOCSFF_48, effect, True)
            self.effect_id = struct.unpack_from("<h", effect, 2)[0]
            os.write(
                self.fd,
                INPUT_EVENT.pack(0, 0, EV_FF, self.effect_id, 1),
            )
            return True
        except OSError as error:
            print(f"Cannot vibrate: {error}", flush=True)
            return False

    def close(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None


class HardwareService:
    def __init__(self):
        self.connection = None
        self.registration = None
        self.state = State()
        self.wacom = self._find_wacom()
        self.settings = Gio.Settings.new("io.github.agcarbajo.TabCompanion")
        self.pen_option_errors = set()
        self.keyboard_fd = None
        self.keyboard_watch = None
        self.pen_fd = None
        self.pen_watch = None
        self.pen_pressed = False
        self.pen_long_fired = False
        self.pen_long_timer = None
        self.pen_single_timer = None
        self.pen_motion = []
        self.pen_motion_energy = 0
        self.pen_motion_active = False
        self.pointer_filtered_x = 0.0
        self.pointer_filtered_y = 0.0
        self.pointer_residual_x = 0.0
        self.pointer_residual_y = 0.0
        self.pointer_gravity_y = None
        self.pointer_gravity_z = None
        self.virtual_watch = None
        self.system_bus = None
        self.bluez_manager = None
        self.ble_device_path = None
        self.ble_paired = False
        self.ble_connected = False
        self.ble_battery = -1
        self.ble_characteristics = {}
        self.ble_subscribed = set()
        self.ble_mode_value = None
        self.ble_battery_valid = False
        self.ble_gatt_ready = False
        self.ble_gatt_failures = 0
        self.ble_next_recovery = 0.0
        self.ble_next_battery_read = 0.0
        self.bluetooth_powered = False
        self.remote_synced = None
        self._init_spen_ble()
        self.settings.connect(
            "changed::spen-remote-enabled", self._remote_enabled_changed
        )
        self.settings.connect(
            "changed::spen-remote-mode", self._remote_mode_changed
        )
        self._migrate_keyboard_codes()
        try:
            self.virtual_keyboard = VirtualKeyboard()
            self.virtual_watch = GLib.io_add_watch(
                self.virtual_keyboard.fd, GLib.IO_IN, self._virtual_output
            )
        except OSError:
            self.virtual_keyboard = None
        try:
            self.virtual_pointer = VirtualPointer()
        except OSError:
            self.virtual_pointer = None
        self.haptics = ForceFeedback()
        self.notification_bus = None
        self.notification_match = (
            "type='method_call',interface='org.freedesktop.Notifications',"
            "member='Notify',eavesdrop='true'"
        )
        self.last_notification_haptic = 0.0
        try:
            self.notification_bus = dbus.SessionBus()
            self.notification_bus.add_match_string(self.notification_match)
            self.notification_bus.add_message_filter(
                self._notification_bus_message
            )
        except dbus.DBusException:
            self.notification_bus = None

    def _notification_bus_message(self, _bus, message):
        if (
            message.get_type() != dbus.lowlevel.MESSAGE_TYPE_METHOD_CALL
            or message.get_interface() != "org.freedesktop.Notifications"
            or message.get_member() != "Notify"
            or not self.settings.get_boolean("notification-haptics-enabled")
        ):
            return
        now = time.monotonic()
        # The session bus may expose both the original and routed method call.
        # Collapse those copies as well as short notification storms.
        if now - self.last_notification_haptic < 0.3:
            return
        self.last_notification_haptic = now
        self.haptics.vibrate(60, 65535)

    def _migrate_keyboard_codes(self):
        version = self.settings.get_uint("keyboard-mapping-version")
        if version < 1:
            self.settings.set_value(
                "keyboard-source-codes", GLib.Variant("a{si}", DEFAULT_SOURCE_CODES)
            )
            self.settings.set_uint("keyboard-mapping-version", 1)
            version = 1
        if version < 2:
            sources = self.settings.get_value("keyboard-source-codes").unpack()
            sources.pop("key-fn-f12", None)
            self.settings.set_value(
                "keyboard-source-codes", GLib.Variant("a{si}", sources)
            )
            targets = self.settings.get_value("action-targets").unpack()
            defaults = self.settings.get_default_value("action-targets").unpack()
            for mapping, target in defaults.items():
                targets.setdefault(mapping, target)
            targets.pop("key-fn-f12", None)
            self.settings.set_value("action-targets", GLib.Variant("a{ss}", targets))
            self.settings.set_uint("keyboard-mapping-version", 2)
            version = 2
        if version < 3:
            # Galaxy AI is the one dedicated launcher owned by this port.
            targets = self.settings.get_value("action-targets").unpack()
            targets["key-galaxy-ai"] = (
                "io.github.agcarbajo.TabCompanion.desktop"
            )
            self.settings.set_value("action-targets", GLib.Variant("a{ss}", targets))
            self.settings.set_string("key-galaxy-ai", "app")
            self.settings.set_uint("keyboard-mapping-version", 3)
            version = 3
        if version < 4:
            # 0.8 initially stored the useful port defaults as explicit user
            # mappings.  Convert only those exact values back to "none" so the
            # UI truthfully shows "Keep the default action" without discarding
            # a different customization.
            targets = self.settings.get_value("action-targets").unpack()
            for mapping, (legacy_action, legacy_target) in DEFAULT_KEY_ACTIONS.items():
                current_action = self.settings.get_string(mapping)
                if current_action not in {"none", legacy_action}:
                    continue
                if legacy_target:
                    if targets.get(mapping, "") != legacy_target:
                        continue
                    targets.pop(mapping, None)
                if current_action == legacy_action:
                    self.settings.reset(mapping)
                    if not legacy_target:
                        targets.pop(mapping, None)
            self.settings.set_value("action-targets", GLib.Variant("a{ss}", targets))
            self.settings.set_uint("keyboard-mapping-version", 4)

    def _init_spen_ble(self):
        try:
            self.system_bus = dbus.SystemBus()
            self.bluez_manager = dbus.Interface(
                self.system_bus.get_object(BLUEZ, "/"),
                "org.freedesktop.DBus.ObjectManager",
            )
            self.system_bus.add_signal_receiver(
                self._bluez_properties_changed,
                dbus_interface=DBUS_PROPERTIES,
                signal_name="PropertiesChanged",
                path_keyword="path",
            )
            self._refresh_bluetooth_powered()
        except dbus.DBusException:
            self.system_bus = None
            self.bluez_manager = None
            self.bluetooth_powered = False

    def _remote_effective(self):
        return (
            self.bluetooth_powered
            and self.settings.get_boolean("spen-remote-enabled")
        )

    def _set_bluetooth_powered(self, powered):
        powered = bool(powered)
        if powered == self.bluetooth_powered:
            return
        self.bluetooth_powered = powered
        self.remote_synced = None
        if not powered:
            self._ble_disconnected()
            if self.virtual_pointer is not None and self.pen_pressed:
                self.virtual_pointer.button(False)
            self.pen_pressed = False
        self._sync_remote_control()

    def _refresh_bluetooth_powered(self):
        if self.bluez_manager is None:
            self._set_bluetooth_powered(False)
            return
        try:
            objects = self.bluez_manager.GetManagedObjects()
        except dbus.DBusException:
            self._set_bluetooth_powered(False)
            return
        self._set_bluetooth_powered(any(
            BLUEZ_ADAPTER in interfaces
            and bool(interfaces[BLUEZ_ADAPTER].get("Powered", False))
            for interfaces in objects.values()
        ))

    def _remote_enabled_changed(self, *_args):
        self.remote_synced = None
        if not self.settings.get_boolean("spen-remote-enabled"):
            self._ble_disconnected()
            if self.virtual_pointer is not None and self.pen_pressed:
                self.virtual_pointer.button(False)
            self.pen_pressed = False
        self._sync_remote_control()

    def _remote_mode_changed(self, *_args):
        if self.pen_pressed and self.virtual_pointer is not None:
            self.virtual_pointer.button(False)
        self.pen_pressed = False
        self.pen_motion = []
        self.pointer_filtered_x = 0.0
        self.pointer_filtered_y = 0.0
        self.pointer_residual_x = 0.0
        self.pointer_residual_y = 0.0
        self.pointer_gravity_y = None
        self.pointer_gravity_z = None
        # The stock driver uses DEFAULT (0x10) for button/gesture events and
        # SENSOR_ON (0x04) for the continuous samples required by a pointer.
        # Force a write even when the BLE link itself did not change.
        self.ble_mode_value = None
        self._refresh_spen_ble()

    def _sync_remote_control(self):
        enabled = self._remote_effective()
        if self.remote_synced == enabled or self.system_bus is None:
            return
        try:
            service = dbus.Interface(
                self.system_bus.get_object(
                    PAIRING_BUS_NAME, PAIRING_OBJECT_PATH, introspect=False
                ),
                PAIRING_BUS_NAME,
            )
            service.SetRemoteEnabled(dbus.Boolean(enabled))
            self.remote_synced = enabled
        except dbus.DBusException:
            pass

    def _spen_gatt_success(self):
        self.ble_gatt_ready = True
        self.ble_gatt_failures = 0

    def _spen_gatt_failure(self):
        self.ble_gatt_ready = False
        # Re-probe on the next sample even if this mode was written earlier;
        # Connected may remain true after the physical GATT link has wedged.
        self.ble_mode_value = None
        self.ble_gatt_failures += 1
        docked = (
            self.wacom is not None
            and read_text(self.wacom / "pen_docked") == "1"
        )
        now = time.monotonic()
        if (
            self.ble_gatt_failures < 3
            or not docked
            or now < self.ble_next_recovery
            or self.system_bus is None
        ):
            return
        self.ble_next_recovery = now + 90
        try:
            service = dbus.Interface(
                self.system_bus.get_object(
                    PAIRING_BUS_NAME, PAIRING_OBJECT_PATH, introspect=False
                ),
                PAIRING_BUS_NAME,
            )
            if service.RecoverStaleBond():
                self._ble_disconnected(self.ble_device_path)
        except dbus.DBusException:
            pass

    @staticmethod
    def _is_spen(properties):
        name = str(properties.get("Alias") or properties.get("Name") or "")
        services = {str(uuid).lower() for uuid in properties.get("UUIDs", [])}
        return name.startswith("SPEN") and SPEN_SERVICES <= services

    def _refresh_spen_ble(self):
        if not self._remote_effective():
            return
        if self.bluez_manager is None:
            return
        try:
            objects = self.bluez_manager.GetManagedObjects()
        except dbus.DBusException:
            self._ble_disconnected()
            return
        match = next(
            (
                (path, interfaces[BLUEZ_DEVICE])
                for path, interfaces in objects.items()
                if BLUEZ_DEVICE in interfaces
                and interfaces[BLUEZ_DEVICE].get("Paired", False)
                and self._is_spen(interfaces[BLUEZ_DEVICE])
            ),
            (None, None),
        )
        device_path, device = match
        self.ble_paired = device is not None
        connected = bool(device and device.get("Connected", False))
        if not connected:
            self._ble_disconnected(device_path)
            return
        if device_path != self.ble_device_path:
            self._ble_disconnected(device_path)
        self.ble_device_path = device_path
        self.ble_connected = True
        self.ble_characteristics = {
            str(interfaces[BLUEZ_GATT]["UUID"]).lower(): path
            for path, interfaces in objects.items()
            if path.startswith(f"{device_path}/") and BLUEZ_GATT in interfaces
        }
        # The raw sensor stream is only useful while the pen is away from its
        # charging cradle.  Enabling SENSOR_ON while docked can make the pen
        # leave the short pairing/charging connection before BlueZ has read
        # its battery and completed bonding.
        docked = (
            self.wacom is not None
            and read_text(self.wacom / "pen_docked") == "1"
        )
        pointer_active = (
            self.settings.get_string("spen-remote-mode") == "pointer" and not docked
        )
        desired_mode = 0x04 if pointer_active else 0x10
        raw_sensor_path = self.ble_characteristics.get(SPEN_RAW_SENSOR_UUID)
        if desired_mode == 0x04 and raw_sensor_path not in self.ble_subscribed:
            try:
                dbus.Interface(
                    self.system_bus.get_object(BLUEZ, raw_sensor_path), BLUEZ_GATT
                ).StartNotify()
            except (dbus.DBusException, TypeError):
                pass
            else:
                self.ble_subscribed.add(raw_sensor_path)
        if (
            SPEN_MODE_UUID in self.ble_characteristics
            and self.ble_mode_value != desired_mode
        ):
            try:
                dbus.Interface(
                    self.system_bus.get_object(
                        BLUEZ, self.ble_characteristics[SPEN_MODE_UUID]
                    ),
                    BLUEZ_GATT,
                ).WriteValue(
                    dbus.Array([dbus.Byte(desired_mode)], signature="y"), {}
                )
                self.ble_mode_value = desired_mode
                self._spen_gatt_success()
            except dbus.DBusException:
                self._spen_gatt_failure()
        if (
            desired_mode != 0x04
            and raw_sensor_path in self.ble_subscribed
        ):
            try:
                dbus.Interface(
                    self.system_bus.get_object(BLUEZ, raw_sensor_path), BLUEZ_GATT
                ).StopNotify()
            except dbus.DBusException:
                pass
            self.ble_subscribed.discard(raw_sensor_path)
        now = time.monotonic()
        if SPEN_BATTERY_UUID in self.ble_characteristics and now >= self.ble_next_battery_read:
            self.ble_next_battery_read = now + 30
            try:
                value = dbus.Interface(
                    self.system_bus.get_object(
                        BLUEZ, self.ble_characteristics[SPEN_BATTERY_UUID]
                    ),
                    BLUEZ_GATT,
                ).ReadValue({})
                if value and int(value[0]) <= 100:
                    self.ble_battery = int(value[0])
                    self.ble_battery_valid = True
                    self._spen_gatt_success()
                else:
                    self.ble_battery_valid = False
                    self._spen_gatt_failure()
            except dbus.DBusException:
                self.ble_battery_valid = False
                self._spen_gatt_failure()
        for uuid in (SPEN_BATTERY_UUID, SPEN_BUTTON_UUID):
            path = self.ble_characteristics.get(uuid)
            if path is None or path in self.ble_subscribed:
                continue
            try:
                dbus.Interface(
                    self.system_bus.get_object(BLUEZ, path), BLUEZ_GATT
                ).StartNotify()
            except dbus.DBusException:
                continue
            self.ble_subscribed.add(path)

    def _ble_disconnected(self, device_path=None):
        self.ble_device_path = device_path
        self.ble_connected = False
        self.ble_characteristics = {}
        self.ble_subscribed.clear()
        self.ble_mode_value = None
        self.ble_battery = -1
        self.ble_battery_valid = False
        self.ble_gatt_ready = False
        self.ble_gatt_failures = 0
        self.ble_next_battery_read = 0.0

    def _bluez_properties_changed(self, interface, changed, _invalidated, path=None):
        if interface == BLUEZ_ADAPTER and "Powered" in changed:
            self._set_bluetooth_powered(changed["Powered"])
            GLib.idle_add(self.sample)
            return
        if interface == BLUEZ_DEVICE and path == self.ble_device_path:
            if changed.get("Connected") is not None and not changed["Connected"]:
                self._ble_disconnected(path)
            return
        if interface != BLUEZ_GATT or "Value" not in changed:
            return
        value = bytes(changed["Value"])
        if path == self.ble_characteristics.get(SPEN_BATTERY_UUID):
            # StartNotify may replay BlueZ's old cached value even when the
            # physical GATT link is wedged. Accept notifications only after a
            # successful ReadValue in this connection.
            if self.ble_battery_valid and value and value[0] <= 100:
                self.ble_battery = value[0]
            return
        if path == self.ble_characteristics.get(SPEN_BUTTON_UUID):
            self._spen_ble_button_data(value)
            return
        if path == self.ble_characteristics.get(SPEN_RAW_SENSOR_UUID):
            self._spen_ble_raw_sensor_data(value)

    def _spen_ble_raw_sensor_data(self, value):
        if (
            not self._remote_effective()
            or self.settings.get_string("spen-remote-mode") != "pointer"
            or (
                self.wacom is not None
                and read_text(self.wacom / "pen_docked") == "1"
            )
            or len(value) < 13
        ):
            return
        # Samsung's SENSOR_ON packet is:
        # marker, accel X/Y/Z, gyro X/Y/Z (all signed little-endian s16).
        # Local X is the pen's longitudinal roll axis and must never move the
        # cursor. Use gravity in the local Y/Z plane to rotate the remaining
        # gyro axes into screen yaw and pitch. This keeps both cursor axes
        # stable when the user rolls the pen through any angle.
        accel_y = int.from_bytes(value[3:5], "little", signed=True)
        accel_z = int.from_bytes(value[5:7], "little", signed=True)
        gyro_y = int.from_bytes(value[9:11], "little", signed=True)
        gyro_z = int.from_bytes(value[11:13], "little", signed=True)
        gravity_norm = math.hypot(accel_y, accel_z)
        if gravity_norm >= 500:
            target_y = accel_y / gravity_norm
            target_z = accel_z / gravity_norm
            if self.pointer_gravity_y is None:
                self.pointer_gravity_y = target_y
                self.pointer_gravity_z = target_z
            else:
                # Gravity changes only with pen roll; a light low-pass filter
                # rejects hand acceleration without making roll compensation
                # feel delayed.
                self.pointer_gravity_y += 0.12 * (
                    target_y - self.pointer_gravity_y
                )
                self.pointer_gravity_z += 0.12 * (
                    target_z - self.pointer_gravity_z
                )
                filtered_norm = math.hypot(
                    self.pointer_gravity_y, self.pointer_gravity_z
                )
                self.pointer_gravity_y /= filtered_norm
                self.pointer_gravity_z /= filtered_norm
        if self.pointer_gravity_y is None:
            return
        yaw = (
            gyro_y * self.pointer_gravity_y
            + gyro_z * self.pointer_gravity_z
        )
        pitch = (
            -gyro_y * self.pointer_gravity_z
            + gyro_z * self.pointer_gravity_y
        )
        if abs(yaw) < 120:
            yaw = 0
        if abs(pitch) < 120:
            pitch = 0
        self._pointer_move(yaw, pitch)

    def _spen_ble_button_data(self, value):
        if not self._remote_effective():
            return
        pointer_mode = self.settings.get_string("spen-remote-mode") == "pointer"
        offset = 0
        count = 1
        if len(value) >= 2 and value[0] == 0xF0:
            count = value[1]
            offset = 2
        for _index in range(count):
            if offset >= len(value):
                break
            header = value[offset]
            if header == 3:
                if pointer_mode and self.virtual_pointer is not None:
                    if not self.pen_pressed:
                        self.pen_pressed = True
                        self.virtual_pointer.button(True)
                else:
                    self._pen_button(True)
                offset += 1
            elif header == 0 and offset + 6 <= len(value):
                if pointer_mode and self.virtual_pointer is not None:
                    if self.pen_pressed:
                        self.virtual_pointer.button(False)
                    self.pen_pressed = False
                else:
                    self._pen_button(False)
                offset += 6
            elif header in {14, 15, 142, 143} and offset + 6 <= len(value):
                dx = int.from_bytes(value[offset + 1:offset + 3], "little", signed=True)
                dy = int.from_bytes(value[offset + 3:offset + 5], "little", signed=True)
                if pointer_mode:
                    pressed = header in {15, 143}
                    if pressed != self.pen_pressed and self.virtual_pointer is not None:
                        self.pen_pressed = pressed
                        self.virtual_pointer.button(pressed)
                    self._pointer_move(dx, dy)
                else:
                    if header in {15, 143} and not self.pen_pressed:
                        self._pen_button(True)
                    self.pen_motion.append((dx, dy))
                    self.pen_motion_energy += abs(dx) + abs(dy)
                    if self.pen_motion_energy >= 300 and not self.pen_motion_active:
                        self.pen_motion_active = True
                        if self.pen_long_timer is not None:
                            GLib.source_remove(self.pen_long_timer)
                            self.pen_long_timer = None
                    if header in {14, 142}:
                        self._pen_button(False)
                offset += 6
            else:
                break

    def _pointer_move(self, raw_x, raw_y):
        if self.virtual_pointer is None:
            return
        sensitivity = min(300, max(25, self.settings.get_int("pointer-sensitivity")))
        smoothing = min(90, max(0, self.settings.get_int("pointer-smoothing")))
        # Raw gyro samples arrive at roughly 24 Hz. This scale is calibrated
        # against the physical sensor range rather than the much smaller
        # gesture deltas used by older firmware modes.
        scale = 0.0045 * sensitivity / 100.0
        if self.settings.get_boolean("pointer-acceleration"):
            scale *= 1.0 + min(
                1.5, (abs(raw_x) + abs(raw_y)) / 6000.0
            )
        # The panel is roughly 1.6 times wider than it is tall. Give yaw the
        # corresponding extra travel, and match both signs to the physical
        # direction confirmed on the tablet.
        target_x = -raw_x * scale * 1.6
        target_y = raw_y * scale
        alpha = 1.0 - smoothing / 110.0
        self.pointer_filtered_x += alpha * (target_x - self.pointer_filtered_x)
        self.pointer_filtered_y += alpha * (target_y - self.pointer_filtered_y)
        self.pointer_residual_x += self.pointer_filtered_x
        self.pointer_residual_y += self.pointer_filtered_y
        move_x = int(self.pointer_residual_x)
        move_y = int(self.pointer_residual_y)
        self.pointer_residual_x -= move_x
        self.pointer_residual_y -= move_y
        self.virtual_pointer.move(move_x, move_y)

    @staticmethod
    def _find_wacom():
        matches = glob("/sys/bus/i2c/devices/*/pen_docked")
        return Path(matches[0]).parent if matches else None

    def _apply_pen_options(self):
        if self.wacom is None:
            return
        options = {
            "ignore_finger_while_hovering": self.settings.get_boolean(
                "ignore-finger-while-hovering"
            ),
            "disable_digitizer_when_docked": self.settings.get_boolean(
                "disable-digitizer-when-docked"
            ),
        }
        for attribute, enabled in options.items():
            path = self.wacom / attribute
            if not path.exists():
                continue
            desired = "1" if enabled else "0"
            if read_text(path) == desired:
                self.pen_option_errors.discard(attribute)
                continue
            try:
                path.write_text(desired + "\n", encoding="ascii")
                self.pen_option_errors.discard(attribute)
            except OSError as error:
                if attribute not in self.pen_option_errors:
                    print(f"Cannot apply S Pen option {attribute}: {error}", flush=True)
                    self.pen_option_errors.add(attribute)

    @staticmethod
    def _keyboard_info():
        for path in glob("/sys/bus/i2c/devices/*/diagnostics"):
            diagnostic = read_text(path)
            if "attached=1" not in diagnostic or "connected=1" not in diagnostic:
                continue
            match = re.search(r"\bmodel=0x([0-9a-fA-F]+)\b", diagnostic)
            protocol = int(match.group(1), 16) if match else -1
            model = KEYBOARD_PROTOCOL_MODELS.get(protocol, "")
            if not model:
                for event in glob("/sys/class/input/event*"):
                    input_name = read_text(Path(event) / "device/name")
                    model_match = re.search(r"\((EF-DX\d+)\)", input_name)
                    if input_name.startswith(KEYBOARD_PREFIX) and model_match:
                        model = model_match.group(1)
                        break
            name = KEYBOARD_MODELS.get(model, "Samsung Book Cover Keyboard")
            return True, model, name
        return False, "", ""

    @staticmethod
    def _find_keyboard_event():
        for path in glob("/sys/class/input/event*"):
            if read_text(Path(path) / "device/name").startswith(KEYBOARD_PREFIX):
                return "/dev/input/" + Path(path).name
        return None

    @staticmethod
    def _find_pen_event():
        for path in glob("/sys/class/input/event*"):
            if read_text(Path(path) / "device/name") == PEN_NAME:
                return "/dev/input/" + Path(path).name
        return None

    def _ensure_keyboard_reader(self):
        if self.keyboard_fd is not None or self.virtual_keyboard is None:
            return
        path = self._find_keyboard_event()
        if not path:
            return
        try:
            self.keyboard_fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
            fcntl.ioctl(self.keyboard_fd, EVIOCGRAB, 1)
        except OSError:
            self.keyboard_fd = None
            return
        self.keyboard_watch = GLib.io_add_watch(
            self.keyboard_fd,
            GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
            self._keyboard_event,
        )

    def _close_keyboard_reader(self):
        if self.keyboard_fd is not None:
            try:
                fcntl.ioctl(self.keyboard_fd, EVIOCGRAB, 0)
            except OSError:
                pass
            os.close(self.keyboard_fd)
            self.keyboard_fd = None
        self.keyboard_watch = None

    def _ensure_pen_reader(self):
        if self.pen_fd is not None:
            return
        path = self._find_pen_event()
        if not path:
            return
        try:
            self.pen_fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            self.pen_fd = None
            return
        self.pen_watch = GLib.io_add_watch(
            self.pen_fd, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._pen_event
        )

    def _close_pen_reader(self):
        if (
            self.pen_pressed
            and self.settings.get_string("spen-remote-mode") == "pointer"
            and self.virtual_pointer is not None
        ):
            self.virtual_pointer.button(False)
            self.pen_pressed = False
        if self.pen_fd is not None:
            os.close(self.pen_fd)
            self.pen_fd = None
        self.pen_watch = None

    def _keyboard_event(self, _source, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self._close_keyboard_reader()
            return GLib.SOURCE_REMOVE
        try:
            data = os.read(self.keyboard_fd, INPUT_EVENT.size * 32)
        except BlockingIOError:
            return GLib.SOURCE_CONTINUE
        except OSError:
            self._close_keyboard_reader()
            return GLib.SOURCE_REMOVE
        if not data:
            self._close_keyboard_reader()
            return GLib.SOURCE_REMOVE
        for offset in range(0, len(data) - INPUT_EVENT.size + 1, INPUT_EVENT.size):
            event = INPUT_EVENT.unpack_from(data, offset)
            _sec, _usec, event_type, code, value = event
            suppress = False
            if event_type == EV_KEY:
                mapping = self._mapping_for_code(code)
                if mapping and (
                    self.settings.get_string(mapping) != "none"
                    or mapping in DEFAULT_KEY_ACTIONS
                ):
                    suppress = True
                    if value == 1:
                        self._replace_dynamic(LastSpecialKey=f"{mapping}:{code}")
                        self.execute_mapping(mapping)
                elif mapping and value == 1:
                    self._replace_dynamic(LastSpecialKey=f"{mapping}:{code}")
            if not suppress and self.virtual_keyboard is not None:
                self.virtual_keyboard.emit(event_type, code, value)
        return GLib.SOURCE_CONTINUE

    def _mapping_for_code(self, code):
        sources = self.settings.get_value("keyboard-source-codes").unpack()
        return next((name for name, source in sources.items() if source == code), None)

    def _virtual_output(self, _source, _condition):
        if self.virtual_keyboard is None:
            return GLib.SOURCE_REMOVE
        data = self.virtual_keyboard.read_output()
        if self.keyboard_fd is not None and data:
            try:
                os.write(self.keyboard_fd, data)
            except OSError:
                pass
        return GLib.SOURCE_CONTINUE

    def _pen_event(self, _source, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self._close_pen_reader()
            return GLib.SOURCE_REMOVE
        try:
            data = os.read(self.pen_fd, INPUT_EVENT.size * 32)
        except BlockingIOError:
            return GLib.SOURCE_CONTINUE
        except OSError:
            self._close_pen_reader()
            return GLib.SOURCE_REMOVE
        if not data:
            self._close_pen_reader()
            return GLib.SOURCE_REMOVE
        for offset in range(0, len(data) - INPUT_EVENT.size + 1, INPUT_EVENT.size):
            _sec, _usec, event_type, code, value = INPUT_EVENT.unpack_from(data, offset)
            if event_type == EV_KEY and code == BTN_STYLUS and value in {0, 1}:
                self._pen_button(value == 1)
        return GLib.SOURCE_CONTINUE

    def _pen_button(self, pressed):
        if not self._remote_effective():
            return
        if self.settings.get_string("spen-remote-mode") == "pointer":
            if self.virtual_pointer is None or pressed == self.pen_pressed:
                return
            self.pen_pressed = pressed
            self.virtual_pointer.button(pressed)
            return
        if pressed:
            if self.pen_pressed:
                return
            self.pen_pressed = True
            self.pen_long_fired = False
            self.pen_motion = []
            self.pen_motion_energy = 0
            self.pen_motion_active = False
            self.pen_long_timer = GLib.timeout_add(600, self._pen_long_press)
            return
        if not self.pen_pressed:
            return
        self.pen_pressed = False
        if self.pen_long_timer is not None:
            GLib.source_remove(self.pen_long_timer)
            self.pen_long_timer = None
        if self.pen_motion_active:
            mapping = classify_spen_motion(self.pen_motion)
            self.pen_motion = []
            self.pen_motion_energy = 0
            self.pen_motion_active = False
            if mapping is not None:
                print(f"S Pen BLE gesture={mapping}", flush=True)
                self.execute_mapping(mapping)
            return
        if self.pen_long_fired:
            return
        if self.pen_single_timer is not None:
            GLib.source_remove(self.pen_single_timer)
            self.pen_single_timer = None
            self.execute_mapping("gesture-double-press")
        else:
            self.pen_single_timer = GLib.timeout_add(300, self._pen_single_press)

    def _pen_long_press(self):
        self.pen_long_timer = None
        if self.pen_pressed:
            self.pen_long_fired = True
            self.execute_mapping("gesture-long-press")
        return GLib.SOURCE_REMOVE

    def _pen_single_press(self):
        self.pen_single_timer = None
        self.execute_mapping("gesture-single-press")
        return GLib.SOURCE_REMOVE

    def execute_mapping(self, mapping):
        if mapping not in MAPPINGS and not mapping.startswith("gesture-"):
            return False
        action = self.settings.get_string(mapping)
        if action == "none":
            default = DEFAULT_KEY_ACTIONS.get(mapping)
            if default is None:
                return True
            action, target = default
        else:
            targets = self.settings.get_value("action-targets").unpack()
            target = targets.get(mapping, "").strip()
        if action in ACTION_KEYS:
            if self.virtual_keyboard is None:
                return False
            self.virtual_keyboard.tap(ACTION_KEYS[action])
            return True
        if action == "flashlight":
            try:
                subprocess.Popen(
                    ["/usr/bin/gts9u-flashlight", "toggle"],
                    start_new_session=True,
                )
                return True
            except OSError as error:
                print(f"Cannot toggle flashlight: {error}", flush=True)
                return False
        if action == "app" and target:
            app = Gio.DesktopAppInfo.new(target)
            if app is None:
                return False
            try:
                app.launch([], None)
                return True
            except GLib.Error as error:
                print(f"Cannot launch {target}: {error.message}", flush=True)
                return False
        if action == "command" and target:
            subprocess.Popen(["sh", "-lc", target], start_new_session=True)
            return True
        if action == "key" and target and self.virtual_keyboard is not None:
            try:
                codes = tuple(int(part) for part in target.split("+") if part)
            except ValueError:
                return False
            if (
                not codes
                or len(codes) > 8
                or any(code < 1 or code > KEY_MAX for code in codes)
            ):
                return False
            self.virtual_keyboard.chord(codes)
            return True
        return False

    def _replace_dynamic(self, **changes):
        values = {field.name: getattr(self.state, field.name) for field in fields(State)}
        values.update(changes)
        self._publish(State(**values))

    def sample(self):
        if self.wacom is None:
            self.wacom = self._find_wacom()
        self._apply_pen_options()
        self._refresh_bluetooth_powered()
        self._sync_remote_control()
        self._ensure_keyboard_reader()
        self._ensure_pen_reader()
        self._refresh_spen_ble()
        if not self.haptics.available and int(time.monotonic()) % 5 == 0:
            self.haptics = ForceFeedback()
        docked = self.wacom is not None and read_text(self.wacom / "pen_docked") == "1"
        raw_orientation = read_text(self.wacom / "pen_orientation") if self.wacom else ""
        orientation = {"downside": "tip-right", "upside": "tip-left"}.get(
            raw_orientation, "unknown"
        )
        charge = read_text(self.wacom / "pen_charging") if self.wacom else "unknown"
        capacity = read_text("/sys/class/power_supply/gts9u-spen/capacity")
        battery = self.ble_battery
        if battery < 0 and capacity.isdigit():
            battery = min(100, max(0, int(capacity)))
        if battery >= 0:
            self.settings.set_int("last-pen-battery", battery)
        else:
            battery = self.settings.get_int("last-pen-battery")
        keyboard_present, keyboard_model, keyboard_name = self._keyboard_info()
        if keyboard_present and keyboard_model:
            self.settings.set_string("known-keyboard-model", keyboard_model)
            self.settings.set_string("known-keyboard-name", keyboard_name)
        self._publish(State(
            PenState="docked" if docked else ("nearby" if self.ble_connected else ("paired" if self.ble_paired else ("unpaired" if self.wacom else "unavailable"))),
            PenOrientation=orientation if docked else "unknown",
            PenBattery=battery,
            PenCharging=docked and charge in {"charging", "full"},
            KeyboardPresent=keyboard_present,
            KeyboardModel=keyboard_model,
            KeyboardName=keyboard_name,
            RemappingAvailable=self.virtual_keyboard is not None and self.keyboard_fd is not None,
            LastSpecialKey=self.state.LastSpecialKey,
            ButtonActionsAvailable=self.pen_fd is not None or self.ble_connected,
            BluetoothAvailable=self.bluetooth_powered,
            GestureAvailable=(
                self._remote_effective()
                and
                self.ble_connected
                and self.ble_gatt_ready
                and self.ble_characteristics.get(SPEN_BUTTON_UUID) in self.ble_subscribed
            ),
            HapticsAvailable=self.haptics.available,
        ))
        return GLib.SOURCE_CONTINUE

    def _publish(self, new_state):
        old_state = self.state
        self.state = new_state
        if self.connection is None:
            return
        changed = {
            field.name: GLib.Variant(SIGNATURES[field.name], getattr(new_state, field.name))
            for field in fields(State)
            if getattr(new_state, field.name) != getattr(old_state, field.name)
        }
        if changed:
            self.connection.emit_signal(
                None, OBJECT_PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                GLib.Variant("(sa{sv}as)", (INTERFACE, changed, [])),
            )

    def method_call(self, _connection, _sender, _path, _interface, method, params, invocation):
        if method == "TriggerMapping":
            mapping = params.unpack()[0]
            invocation.return_value(GLib.Variant("(b)", (self.execute_mapping(mapping),)))
        elif method == "Vibrate":
            duration_ms, magnitude = params.unpack()
            # Version 1 of the live Shell extension may remain cached until
            # logout. Translate its three keyboard pulse tokens in the
            # service so stronger feedback applies immediately as well as on
            # the next graphical session.
            duration_ms = {8: 24, 14: 42, 22: 66}.get(
                duration_ms, duration_ms
            )
            invocation.return_value(GLib.Variant(
                "(b)", (self.haptics.vibrate(duration_ms, magnitude),)
            ))

    def get_property(self, _connection, _sender, _path, _interface, name):
        return GLib.Variant(SIGNATURES[name], getattr(self.state, name))

    def acquired(self, connection, _name):
        self.connection = connection
        node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)
        self.registration = connection.register_object(
            OBJECT_PATH, node.interfaces[0], self.method_call, self.get_property, None
        )
        self.sample()
        GLib.timeout_add_seconds(1, self.sample)

    def close(self):
        self._close_keyboard_reader()
        self._close_pen_reader()
        for timer in (self.pen_long_timer, self.pen_single_timer):
            if timer is not None:
                GLib.source_remove(timer)
        if self.virtual_watch is not None:
            GLib.source_remove(self.virtual_watch)
            self.virtual_watch = None
        if self.virtual_keyboard is not None:
            self.virtual_keyboard.close()
        if self.virtual_pointer is not None:
            self.virtual_pointer.close()
        if self.notification_bus is not None:
            self.notification_bus.remove_message_filter(
                self._notification_bus_message
            )
            try:
                self.notification_bus.remove_match_string(
                    self.notification_match
                )
            except dbus.DBusException:
                pass
        self.haptics.close()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--self-test-uinput", action="store_true")
    args = parser.parse_args()
    if args.self_test_uinput:
        keyboard = VirtualKeyboard()
        keyboard.tap(KEY_F24)
        print("emitted KEY_F24 through Tab Companion virtual keyboard")
        GLib.usleep(200000)
        keyboard.close()
        return

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    service = HardwareService()
    owner = Gio.bus_own_name(
        Gio.BusType.SESSION, BUS_NAME, Gio.BusNameOwnerFlags.NONE,
        service.acquired, None, None,
    )
    try:
        GLib.MainLoop().run()
    finally:
        service.close()
        Gio.bus_unown_name(owner)


if __name__ == "__main__":
    main()

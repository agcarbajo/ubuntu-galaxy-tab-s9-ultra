import subprocess
import time

import dbus
import dbus.mainloop.glib
from gi.repository import Gio, GLib


BUS_NAME = "io.github.agcarbajo.TabCompanion.Hardware"
OBJECT_PATH = "/io/github/agcarbajo/TabCompanion/Hardware"
INTERFACE = BUS_NAME
KEYBOARD_NAME = "Book Cover Keyboard Slim (EF-DX920)"
PEN_NAME = "Wacom EMR Digitizer"
BLUEZ = "org.bluez"
BLUEZ_DEVICE = "org.bluez.Device1"
BLUEZ_GATT = "org.bluez.GattCharacteristic1"
DBUS_PROPERTIES = "org.freedesktop.DBus.Properties"
SPEN_SERVICES = {
    "0000fd6c-0000-1000-8000-00805f9b34fb",
    "0000fef5-0000-1000-8000-00805f9b34fb",
}
SPEN_BATTERY_UUID = "5a87b4ef-3bfa-76a8-e642-92933c31434f"
SPEN_BUTTON_UUID = "6c290d2e-1c03-aca1-ab48-a9b908bae79e"
SPEN_MODE_UUID = "aca1ab48-08ba-e79e-ab48-a9b9e6429293"
MAPPINGS = {
    "key-galaxy-ai", "key-dex", "key-finder", "key-settings",
    "key-fn-f1", "key-fn-f2", "key-fn-f3", "key-fn-f4", "key-fn-f5",
    "key-fn-f6", "key-fn-f7", "key-fn-f8", "key-fn-f9", "key-fn-f10",
    "key-fn-f11", "key-fn-f12",
}

# Measured on the physical EF-DX920 with firmware 0x00370037.  Fn+F12 does
# not produce a controller event, so it intentionally has no built-in code.
DEFAULT_SOURCE_CODES = {
    "key-galaxy-ai": 760,
    "key-dex": 701,
    "key-finder": 710,
    "key-settings": 709,
    "key-fn-f1": 757,
    "key-fn-f2": 758,
    "key-fn-f3": 759,
    "key-fn-f4": 705,
    "key-fn-f5": 254,
    "key-fn-f6": 172,
    "key-fn-f7": 224,
    "key-fn-f8": 225,
    "key-fn-f9": 113,
    "key-fn-f10": 114,
    "key-fn-f11": 115,
}

EV_SYN = 0
EV_KEY = 1
EV_SW = 5
EV_LED = 17
SYN_REPORT = 0
SW_LID = 0
LED_CAPSL = 1
BTN_STYLUS = 331
KEY_F24 = 194
KEY_MAX = 767
INPUT_EVENT = struct.Struct("llHHi")
UI_SET_EVBIT = 0x40045564
UI_SET_KEYBIT = 0x40045565
UI_SET_LEDBIT = 0x40045569
UI_SET_SWBIT = 0x4004556D
UI_DEV_CREATE = 0x5501
UI_DEV_DESTROY = 0x5502
UI_DEV_SETUP = 0x405C5503
EVIOCGRAB = 0x40044590

ACTION_KEYS = {
    "screenshot": 99,       # KEY_SYSRQ
    "back": 158,            # KEY_BACK
    "home": 172,            # KEY_HOMEPAGE
    "overview": 125,        # KEY_LEFTMETA
    "play-pause": 164,
    "previous": 165,
    "next": 163,
    "volume-up": 115,
    "volume-down": 114,
    "mute": 113,
}

INTROSPECTION = """
<node>
  <interface name="io.github.agcarbajo.TabCompanion.Hardware">
    <method name="BeginKeyCapture"><arg name="mapping" type="s" direction="in"/><arg name="accepted" type="b" direction="out"/></method>
    <method name="CancelKeyCapture"/>
    <method name="TriggerMapping"><arg name="mapping" type="s" direction="in"/><arg name="accepted" type="b" direction="out"/></method>
    <property name="PenState" type="s" access="read"/>
    <property name="PenOrientation" type="s" access="read"/>
    <property name="PenBattery" type="i" access="read"/>
    <property name="PenCharging" type="b" access="read"/>
    <property name="KeyboardPresent" type="b" access="read"/>
    <property name="RemappingAvailable" type="b" access="read"/>
    <property name="CapturingKey" type="s" access="read"/>
    <property name="LastSpecialKey" type="s" access="read"/>
    <property name="ButtonActionsAvailable" type="b" access="read"/>
    <property name="BluetoothAvailable" type="b" access="read"/>
    <property name="GestureAvailable" type="b" access="read"/>
  </interface>
</node>
"""


@dataclass(frozen=True)
class State:
    PenState: str = "unavailable"
    PenOrientation: str = "unknown"
    PenBattery: int = -1
    PenCharging: bool = False
    KeyboardPresent: bool = False
    RemappingAvailable: bool = False
    CapturingKey: str = ""
    LastSpecialKey: str = ""
    ButtonActionsAvailable: bool = False
    BluetoothAvailable: bool = False
    GestureAvailable: bool = False


SIGNATURES = {
    "PenState": "s", "PenOrientation": "s", "PenBattery": "i",
    "PenCharging": "b", "KeyboardPresent": "b", "RemappingAvailable": "b",
    "CapturingKey": "s", "LastSpecialKey": "s", "ButtonActionsAvailable": "b",
    "BluetoothAvailable": "b",
    "GestureAvailable": "b",
}


def read_text(path, fallback=""):
    try:
        return Path(path).read_text(encoding="ascii").strip()
    except (OSError, UnicodeError):
        return fallback


def classify_spen_motion(points):
    """Classify Samsung's incremental dx/dy samples from one button hold."""
    if len(points) < 5:
        return None
    sum_x = sum(point[0] for point in points)
    sum_y = sum(point[1] for point in points)
    abs_x = sum(abs(point[0]) for point in points)
    abs_y = sum(abs(point[1]) for point in points)
    if abs_x + abs_y < 300:
        return None

    x = 0
    y = 0
    area2 = 0
    for dx, dy in points:
        next_x = x + dx
        next_y = y + dy
        area2 += x * next_y - next_x * y
        x = next_x
        y = next_y

    # A circle covers both axes and encloses far more signed area than a swipe.
    if min(abs_x, abs_y) > 1000 and abs(area2) > 500000:
        return (
            "gesture-circle-clockwise"
            if area2 > 0
            else "gesture-circle-counterclockwise"
        )
    if abs_x > abs_y:
        if abs(sum_x) < 80:
            return None
        return "gesture-swipe-right" if sum_x > 0 else "gesture-swipe-left"
    if abs(sum_y) < 80:
        return None
    return "gesture-swipe-down" if sum_y > 0 else "gesture-swipe-up"


class VirtualKeyboard:
    def __init__(self):
        self.fd = os.open("/dev/uinput", os.O_RDWR | os.O_NONBLOCK)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_SW)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_LED)
        for code in range(1, KEY_MAX + 1):
            fcntl.ioctl(self.fd, UI_SET_KEYBIT, code)
        fcntl.ioctl(self.fd, UI_SET_SWBIT, SW_LID)
        fcntl.ioctl(self.fd, UI_SET_LEDBIT, LED_CAPSL)
        name = b"Tab Companion virtual keyboard".ljust(80, b"\0")
        setup = struct.pack("HHHH80sI", 0x03, 0x04E8, 0xA036, 1, name, 0)
        fcntl.ioctl(self.fd, UI_DEV_SETUP, setup)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)

    def emit(self, event_type, code, value):
        os.write(self.fd, INPUT_EVENT.pack(0, 0, event_type, code, value))

    def tap(self, code):
        self.emit(EV_KEY, code, 1)
        self.emit(EV_SYN, SYN_REPORT, 0)
        self.emit(EV_KEY, code, 0)
        self.emit(EV_SYN, SYN_REPORT, 0)

    def read_output(self):
        try:
            return os.read(self.fd, INPUT_EVENT.size * 8)
        except BlockingIOError:
            return b""

    def close(self):
        if self.fd is not None:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
            os.close(self.fd)
            self.fd = None


class HardwareService:
    def __init__(self):
        self.connection = None
        self.registration = None
        self.state = State()
        self.wacom = self._find_wacom()
        self.settings = Gio.Settings.new("io.github.agcarbajo.TabCompanion")
        self.keyboard_fd = None
        self.keyboard_watch = None
        self.pen_fd = None
        self.pen_watch = None
        self.pen_pressed = False
        self.pen_long_fired = False
        self.pen_long_timer = None
        self.pen_single_timer = None
        self.pen_motion = []
        self.pen_motion_energy = 0
        self.pen_motion_active = False
        self.capture_mapping = ""
        self.capture_timer = None
        self.capture_passthrough = set()
        self.virtual_watch = None
        self.system_bus = None
        self.bluez_manager = None
        self.ble_device_path = None
        self.ble_paired = False
        self.ble_connected = False
        self.ble_battery = -1
        self.ble_characteristics = {}
        self.ble_subscribed = set()
        self.ble_mode_set = False
        self.ble_next_battery_read = 0.0
        self._init_spen_ble()
        self._migrate_keyboard_codes()
        try:
            self.virtual_keyboard = VirtualKeyboard()
            self.virtual_watch = GLib.io_add_watch(
                self.virtual_keyboard.fd, GLib.IO_IN, self._virtual_output
            )
        except OSError:
            self.virtual_keyboard = None

    def _migrate_keyboard_codes(self):
        if self.settings.get_uint("keyboard-mapping-version") < 1:
            self.settings.set_value(
                "keyboard-source-codes", GLib.Variant("a{si}", DEFAULT_SOURCE_CODES)
            )
            self.settings.set_uint("keyboard-mapping-version", 1)

    def _init_spen_ble(self):
        try:
            self.system_bus = dbus.SystemBus()
            self.bluez_manager = dbus.Interface(
                self.system_bus.get_object(BLUEZ, "/"),
                "org.freedesktop.DBus.ObjectManager",
            )
            self.system_bus.add_signal_receiver(
                self._bluez_properties_changed,
                dbus_interface=DBUS_PROPERTIES,
                signal_name="PropertiesChanged",
                path_keyword="path",
            )
        except dbus.DBusException:
            self.system_bus = None
            self.bluez_manager = None

    @staticmethod
    def _is_spen(properties):
        name = str(properties.get("Alias") or properties.get("Name") or "")
        services = {str(uuid).lower() for uuid in properties.get("UUIDs", [])}
        return name.startswith("SPEN") and SPEN_SERVICES <= services

    def _refresh_spen_ble(self):
        if self.bluez_manager is None:
            return
        try:
            objects = self.bluez_manager.GetManagedObjects()
        except dbus.DBusException:
            self._ble_disconnected()
            return
        match = next(
            (
                (path, interfaces[BLUEZ_DEVICE])
                for path, interfaces in objects.items()
                if BLUEZ_DEVICE in interfaces
                and interfaces[BLUEZ_DEVICE].get("Paired", False)
                and self._is_spen(interfaces[BLUEZ_DEVICE])
            ),
            (None, None),
        )
        device_path, device = match
        self.ble_paired = device is not None
        connected = bool(device and device.get("Connected", False))
        if not connected:
            self._ble_disconnected(device_path)
            return
        if device_path != self.ble_device_path:
            self._ble_disconnected(device_path)
        self.ble_device_path = device_path
        self.ble_connected = True
        self.ble_characteristics = {
            str(interfaces[BLUEZ_GATT]["UUID"]).lower(): path
            for path, interfaces in objects.items()
            if path.startswith(f"{device_path}/") and BLUEZ_GATT in interfaces
        }
        if SPEN_MODE_UUID in self.ble_characteristics and not self.ble_mode_set:
            try:
                dbus.Interface(
                    self.system_bus.get_object(
                        BLUEZ, self.ble_characteristics[SPEN_MODE_UUID]
                    ),
                    BLUEZ_GATT,
                ).WriteValue(dbus.Array([dbus.Byte(0x10)], signature="y"), {})
                self.ble_mode_set = True
            except dbus.DBusException:
                pass
        now = time.monotonic()
        if SPEN_BATTERY_UUID in self.ble_characteristics and now >= self.ble_next_battery_read:
            self.ble_next_battery_read = now + 30
            try:
                value = dbus.Interface(
                    self.system_bus.get_object(
                        BLUEZ, self.ble_characteristics[SPEN_BATTERY_UUID]
                    ),
                    BLUEZ_GATT,
                ).ReadValue({})
                self.ble_battery = int(value[0]) if value else -1
            except dbus.DBusException:
                pass
        for uuid in (SPEN_BATTERY_UUID, SPEN_BUTTON_UUID):
            path = self.ble_characteristics.get(uuid)
            if path is None or path in self.ble_subscribed:
                continue
            try:
                dbus.Interface(
                    self.system_bus.get_object(BLUEZ, path), BLUEZ_GATT
                ).StartNotify()
            except dbus.DBusException:
                continue
            self.ble_subscribed.add(path)

    def _ble_disconnected(self, device_path=None):
        self.ble_device_path = device_path
        self.ble_connected = False
        self.ble_characteristics = {}
        self.ble_subscribed.clear()
        self.ble_mode_set = False
        self.ble_next_battery_read = 0.0

    def _bluez_properties_changed(self, interface, changed, _invalidated, path=None):
        if interface == BLUEZ_DEVICE and path == self.ble_device_path:
            if changed.get("Connected") is not None and not changed["Connected"]:
                self._ble_disconnected(path)
            return
        if interface != BLUEZ_GATT or "Value" not in changed:
            return
        value = bytes(changed["Value"])
        if path == self.ble_characteristics.get(SPEN_BATTERY_UUID):
            if value and value[0] <= 100:
                self.ble_battery = value[0]
            return
        if path == self.ble_characteristics.get(SPEN_BUTTON_UUID):
            self._spen_ble_button_data(value)

    def _spen_ble_button_data(self, value):
        offset = 0
        count = 1
        if len(value) >= 2 and value[0] == 0xF0:
            count = value[1]
            offset = 2
        for _index in range(count):
            if offset >= len(value):
                break
            header = value[offset]
            if header == 3:
                self._pen_button(True)
                offset += 1
            elif header == 0 and offset + 6 <= len(value):
                self._pen_button(False)
                offset += 6
            elif header in {14, 15, 142, 143} and offset + 6 <= len(value):
                dx = int.from_bytes(value[offset + 1:offset + 3], "little", signed=True)
                dy = int.from_bytes(value[offset + 3:offset + 5], "little", signed=True)
                if header in {15, 143} and not self.pen_pressed:
                    self._pen_button(True)
                self.pen_motion.append((dx, dy))
                self.pen_motion_energy += abs(dx) + abs(dy)
                if self.pen_motion_energy >= 300 and not self.pen_motion_active:
                    self.pen_motion_active = True
                    if self.pen_long_timer is not None:
                        GLib.source_remove(self.pen_long_timer)
                        self.pen_long_timer = None
                if header in {14, 142}:
                    self._pen_button(False)
                offset += 6
            else:
                break

    @staticmethod
    def _find_wacom():
        matches = glob("/sys/bus/i2c/devices/*/pen_docked")
        return Path(matches[0]).parent if matches else None

    @staticmethod
    def _keyboard_present():
        return any(
            "attached=1" in read_text(path) and "connected=1" in read_text(path)
            for path in glob("/sys/bus/i2c/devices/*/diagnostics")
        )

    @staticmethod
    def _find_keyboard_event():
        for path in glob("/sys/class/input/event*"):
            if read_text(Path(path) / "device/name") == KEYBOARD_NAME:
                return "/dev/input/" + Path(path).name
        return None

    @staticmethod
    def _find_pen_event():
        for path in glob("/sys/class/input/event*"):
            if read_text(Path(path) / "device/name") == PEN_NAME:
                return "/dev/input/" + Path(path).name
        return None

    def _ensure_keyboard_reader(self):
        if self.keyboard_fd is not None or self.virtual_keyboard is None:
            return
        path = self._find_keyboard_event()
        if not path:
            return
        try:
            self.keyboard_fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
            fcntl.ioctl(self.keyboard_fd, EVIOCGRAB, 1)
        except OSError:
            self.keyboard_fd = None
            return
        self.keyboard_watch = GLib.io_add_watch(
            self.keyboard_fd,
            GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
            self._keyboard_event,
        )

    def _close_keyboard_reader(self):
        if self.keyboard_fd is not None:
            try:
                fcntl.ioctl(self.keyboard_fd, EVIOCGRAB, 0)
            except OSError:
                pass
            os.close(self.keyboard_fd)
            self.keyboard_fd = None
        self.keyboard_watch = None

    def _ensure_pen_reader(self):
        if self.pen_fd is not None:
            return
        path = self._find_pen_event()
        if not path:
            return
        try:
            self.pen_fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            self.pen_fd = None
            return
        self.pen_watch = GLib.io_add_watch(
            self.pen_fd, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._pen_event
        )

    def _close_pen_reader(self):
        if self.pen_fd is not None:
            os.close(self.pen_fd)
            self.pen_fd = None
        self.pen_watch = None

    def _keyboard_event(self, _source, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self._close_keyboard_reader()
            return GLib.SOURCE_REMOVE
        try:
            data = os.read(self.keyboard_fd, INPUT_EVENT.size * 32)
        except BlockingIOError:
            return GLib.SOURCE_CONTINUE
        except OSError:
            self._close_keyboard_reader()
            return GLib.SOURCE_REMOVE
        if not data:
            self._close_keyboard_reader()
            return GLib.SOURCE_REMOVE
        for offset in range(0, len(data) - INPUT_EVENT.size + 1, INPUT_EVENT.size):
            event = INPUT_EVENT.unpack_from(data, offset)
            _sec, _usec, event_type, code, value = event
            suppress = False
            if event_type == EV_KEY:
                if code in self.capture_passthrough:
                    if value == 0:
                        self.capture_passthrough.discard(code)
                elif value == 1 and self.capture_mapping:
                    self.capture_passthrough.add(code)
                    self._capture_key(code)
                else:
                    mapping = self._mapping_for_code(code)
                    if mapping and self.settings.get_string(mapping) != "none":
                        suppress = True
                        if value == 1:
                            self._replace_dynamic(LastSpecialKey=f"{mapping}:{code}")
                            self.execute_mapping(mapping)
                    elif mapping and value == 1:
                        self._replace_dynamic(LastSpecialKey=f"{mapping}:{code}")
            if not suppress and self.virtual_keyboard is not None:
                self.virtual_keyboard.emit(event_type, code, value)
        return GLib.SOURCE_CONTINUE

    def _mapping_for_code(self, code):
        sources = self.settings.get_value("keyboard-source-codes").unpack()
        return next((name for name, source in sources.items() if source == code), None)

    def _capture_key(self, code):
        sources = self.settings.get_value("keyboard-source-codes").unpack()
        for mapping, source in list(sources.items()):
            if source == code and mapping != self.capture_mapping:
                sources.pop(mapping)
        sources[self.capture_mapping] = code
        self.settings.set_value("keyboard-source-codes", GLib.Variant("a{si}", sources))
        captured = self.capture_mapping
        self._cancel_capture()
        self._replace_dynamic(CapturingKey="", LastSpecialKey=f"{captured}:{code}")

    def _cancel_capture(self):
        self.capture_mapping = ""
        if self.capture_timer is not None:
            GLib.source_remove(self.capture_timer)
            self.capture_timer = None

    def _capture_timeout(self):
        mapping = self.capture_mapping
        self.capture_timer = None
        self.capture_mapping = ""
        self._replace_dynamic(CapturingKey="", LastSpecialKey=f"capture-timeout:{mapping}")
        return GLib.SOURCE_REMOVE

    def _virtual_output(self, _source, _condition):
        if self.virtual_keyboard is None:
            return GLib.SOURCE_REMOVE
        data = self.virtual_keyboard.read_output()
        if self.keyboard_fd is not None and data:
            try:
                os.write(self.keyboard_fd, data)
            except OSError:
                pass
        return GLib.SOURCE_CONTINUE

    def _pen_event(self, _source, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self._close_pen_reader()
            return GLib.SOURCE_REMOVE
        try:
            data = os.read(self.pen_fd, INPUT_EVENT.size * 32)
        except BlockingIOError:
            return GLib.SOURCE_CONTINUE
        except OSError:
            self._close_pen_reader()
            return GLib.SOURCE_REMOVE
        if not data:
            self._close_pen_reader()
            return GLib.SOURCE_REMOVE
        for offset in range(0, len(data) - INPUT_EVENT.size + 1, INPUT_EVENT.size):
            _sec, _usec, event_type, code, value = INPUT_EVENT.unpack_from(data, offset)
            if event_type == EV_KEY and code == BTN_STYLUS and value in {0, 1}:
                self._pen_button(value == 1)
        return GLib.SOURCE_CONTINUE

    def _pen_button(self, pressed):
        if pressed:
            if self.pen_pressed:
                return
            self.pen_pressed = True
            self.pen_long_fired = False
            self.pen_motion = []
            self.pen_motion_energy = 0
            self.pen_motion_active = False
            self.pen_long_timer = GLib.timeout_add(600, self._pen_long_press)
            return
        if not self.pen_pressed:
            return
        self.pen_pressed = False
        if self.pen_long_timer is not None:
            GLib.source_remove(self.pen_long_timer)
            self.pen_long_timer = None
        if self.pen_motion_active:
            mapping = classify_spen_motion(self.pen_motion)
            self.pen_motion = []
            self.pen_motion_energy = 0
            self.pen_motion_active = False
            if mapping is not None:
                print(f"S Pen BLE gesture={mapping}", flush=True)
                self.execute_mapping(mapping)
            return
        if self.pen_long_fired:
            return
        if self.pen_single_timer is not None:
            GLib.source_remove(self.pen_single_timer)
            self.pen_single_timer = None
            self.execute_mapping("gesture-double-press")
        else:
            self.pen_single_timer = GLib.timeout_add(300, self._pen_single_press)

    def _pen_long_press(self):
        self.pen_long_timer = None
        if self.pen_pressed:
            self.pen_long_fired = True
            self.execute_mapping("gesture-long-press")
        return GLib.SOURCE_REMOVE

    def _pen_single_press(self):
        self.pen_single_timer = None
        self.execute_mapping("gesture-single-press")
        return GLib.SOURCE_REMOVE

    def execute_mapping(self, mapping):
        if mapping not in MAPPINGS and not mapping.startswith("gesture-"):
            return False
        action = self.settings.get_string(mapping)
        if action == "none":
            return True
        if action in ACTION_KEYS:
            if self.virtual_keyboard is None:
                return False
            self.virtual_keyboard.tap(ACTION_KEYS[action])
            return True
        targets = self.settings.get_value("action-targets").unpack()
        target = targets.get(mapping, "").strip()
        if action == "app" and target:
            subprocess.Popen(["gtk-launch", target], start_new_session=True)
            return True
        if action == "command" and target:
            subprocess.Popen(["sh", "-lc", target], start_new_session=True)
            return True
        return False

    def _replace_dynamic(self, **changes):
        values = {field.name: getattr(self.state, field.name) for field in fields(State)}
        values.update(changes)
        self._publish(State(**values))

    def sample(self):
        if self.wacom is None:
            self.wacom = self._find_wacom()
        self._ensure_keyboard_reader()
        self._ensure_pen_reader()
        self._refresh_spen_ble()
        docked = self.wacom is not None and read_text(self.wacom / "pen_docked") == "1"
        raw_orientation = read_text(self.wacom / "pen_orientation") if self.wacom else ""
        orientation = {"downside": "tip-right", "upside": "tip-left"}.get(
            raw_orientation, "unknown"
        )
        charge = read_text(self.wacom / "pen_charging") if self.wacom else "unknown"
        capacity = read_text("/sys/class/power_supply/gts9u-spen/capacity")
        battery = self.ble_battery
        if battery < 0 and capacity.isdigit():
            battery = min(100, max(0, int(capacity)))
        self._publish(State(
            PenState="docked" if docked else ("nearby" if self.ble_connected else ("paired" if self.ble_paired else ("unpaired" if self.wacom else "unavailable"))),
            PenOrientation=orientation if docked else "unknown",
            PenBattery=battery,
            PenCharging=docked and charge in {"charging", "full"},
            KeyboardPresent=self._keyboard_present(),
            RemappingAvailable=self.virtual_keyboard is not None and self.keyboard_fd is not None,
            CapturingKey=self.capture_mapping,
            LastSpecialKey=self.state.LastSpecialKey,
            ButtonActionsAvailable=self.pen_fd is not None or self.ble_connected,
            BluetoothAvailable=Path("/sys/class/bluetooth/hci0").exists(),
            GestureAvailable=(
                self.ble_connected
                and self.ble_characteristics.get(SPEN_BUTTON_UUID) in self.ble_subscribed
            ),
        ))
        return GLib.SOURCE_CONTINUE

    def _publish(self, new_state):
        old_state = self.state
        self.state = new_state
        if self.connection is None:
            return
        changed = {
            field.name: GLib.Variant(SIGNATURES[field.name], getattr(new_state, field.name))
            for field in fields(State)
            if getattr(new_state, field.name) != getattr(old_state, field.name)
        }
        if changed:
            self.connection.emit_signal(
                None, OBJECT_PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                GLib.Variant("(sa{sv}as)", (INTERFACE, changed, [])),
            )

    def method_call(self, _connection, _sender, _path, _interface, method, params, invocation):
        if method == "BeginKeyCapture":
            mapping = params.unpack()[0]
            accepted = mapping in MAPPINGS and self.keyboard_fd is not None
            if accepted:
                self._cancel_capture()
                self.capture_mapping = mapping
                self.capture_timer = GLib.timeout_add_seconds(8, self._capture_timeout)
                self._replace_dynamic(CapturingKey=mapping)
            invocation.return_value(GLib.Variant("(b)", (accepted,)))
        elif method == "CancelKeyCapture":
            self._cancel_capture()
            self._replace_dynamic(CapturingKey="")
            invocation.return_value(None)
        elif method == "TriggerMapping":
            mapping = params.unpack()[0]
            invocation.return_value(GLib.Variant("(b)", (self.execute_mapping(mapping),)))

    def get_property(self, _connection, _sender, _path, _interface, name):
        return GLib.Variant(SIGNATURES[name], getattr(self.state, name))

    def acquired(self, connection, _name):
        self.connection = connection
        node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)
        self.registration = connection.register_object(
            OBJECT_PATH, node.interfaces[0], self.method_call, self.get_property, None
        )
        self.sample()
        GLib.timeout_add_seconds(1, self.sample)

    def close(self):
        self._close_keyboard_reader()
        self._close_pen_reader()
        for timer in (self.pen_long_timer, self.pen_single_timer):
            if timer is not None:
                GLib.source_remove(timer)
        self._cancel_capture()
        if self.virtual_watch is not None:
            GLib.source_remove(self.virtual_watch)
            self.virtual_watch = None
        if self.virtual_keyboard is not None:
            self.virtual_keyboard.close()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--self-test-uinput", action="store_true")
    args = parser.parse_args()
    if args.self_test_uinput:
        keyboard = VirtualKeyboard()
        keyboard.tap(KEY_F24)
        print("emitted KEY_F24 through Tab Companion virtual keyboard")
        GLib.usleep(200000)
        keyboard.close()
        return

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    service = HardwareService()
    owner = Gio.bus_own_name(
        Gio.BusType.SESSION, BUS_NAME, Gio.BusNameOwnerFlags.NONE,
        service.acquired, None, None,
    )
    try:
        GLib.MainLoop().run()
    finally:
        service.close()
        Gio.bus_unown_name(owner)


if __name__ == "__main__":
    main()
